+    if (!copy) goto refuse;
+    bcopy(pages,copy,count*sizeof(*copy));
+    if (!pgdr_observe()) { IOFree(copy,count*sizeof(*copy)); pgdr_poison("map idle/context observation"); goto refuse; }
