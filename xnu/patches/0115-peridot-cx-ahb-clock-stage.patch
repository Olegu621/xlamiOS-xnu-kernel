+
+/* Mode3 stage. Holds the previously collapsed CX domain live while ONLY the
+ * configuration AHB gate (0x90c8) is toggled, then restores both. This gate
+ * is from MiCode gpucc-cliffs.c and is a BRANCH_HALT_DELAY class branch: its
+ * status reads cannot prove switching, so the enable bit readback is the
+ * check. Refuse unreadable gate values, unknown bits beyond ON and STATUS,
+ * and an already-on gate. Hard bounds are the power-stage ones: bounded 50ms
+ * waits, restore-on-timeout, and leave for the diagnostic reset when
+ * ownership changes unexpectedly. No GMU, GPU core or SMMU access, no other
+ * gates, RCGs, votes or resets, and no firmware upload.
+ */
+#define PGPU_AHB_CBCR 0x90c8u
+#define PGPU_AHB_ON 1u
+#define PGPU_AHB_STATUS (1u << 31)
+#define PGPU_AHB_KNOWN (PGPU_AHB_ON | PGPU_AHB_STATUS)
+
+enum pgpu_clock_result {
+	PGPU_CLOCK_REFUSED = 0,
+	PGPU_CLOCK_PASS,
+	PGPU_CLOCK_ON_TIMEOUT,
+	PGPU_CLOCK_AHB_ON_TIMEOUT,
+	PGPU_CLOCK_AHB_RESTORE_TIMEOUT,
+	PGPU_CLOCK_OFF_TIMEOUT,
+	PGPU_CLOCK_OWNERSHIP_LOST
+};
+
+static inline bool
+pgpu_ahb_gate_settled(const struct pgpu_power_io *io, bool on)
+{
+	for (unsigned i = 0; i < 500; ++i) {
+		io->delay_us(100);
+		uint32_t gate = io->read(io->context, PGPU_AHB_CBCR);
+		if (gate == UINT32_MAX) {
+			return false;
+		}
+		if (((gate & PGPU_AHB_ON) != 0) == on) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* hold_ms is capped at200 inside the stage so the whole sequence stays
+ * inside the diagnostic reset budget; the boot-arg validation belongs to
+ * board support. observe, when non-NULL, runs while CX is live and the
+ * configuration AHB gate has just been verified on, before the hold. */
+static inline enum pgpu_clock_result
+pgpu_cx_hold_ahb_stage(const struct pgpu_power_io *io, unsigned hold_ms,
+    uint32_t *cx_final, uint32_t *gx_final, uint32_t *ahb_final,
+    void *observe_ctx, void (*observe)(void *observe_ctx))
+{
+	uint32_t cx = io->read(io->context, PGPU_CX_GDSCR);
+	uint32_t hw = io->read(io->context, PGPU_CX_HW);
+	uint32_t gx = io->read(io->context, PGPU_GX_GDSCR);
+	if (!pgpu_collapsed(cx) || !pgpu_collapsed(gx) ||
+	    hw == UINT32_MAX || (hw & PGPU_ON)) {
+		return PGPU_CLOCK_REFUSED;
+	}
+	uint32_t gate = io->read(io->context, PGPU_AHB_CBCR);
+	if (gate == UINT32_MAX || (gate & ~PGPU_AHB_KNOWN) ||
+	    (gate & PGPU_AHB_ON)) {
+		return PGPU_CLOCK_REFUSED;
+	}
+	io->write(io->context, PGPU_CX_GDSCR, cx & ~PGPU_COLLAPSE);
+	bool powered = pgpu_power_wait(io, true);
+	bool gate_leg = true;
+	cx = io->read(io->context, PGPU_CX_GDSCR);
+	gx = io->read(io->context, PGPU_GX_GDSCR);
+	if (cx == UINT32_MAX || (cx & (PGPU_HW_CONTROL | PGPU_OVERRIDE)) ||
+	    !pgpu_collapsed(gx)) {
+		return PGPU_CLOCK_OWNERSHIP_LOST;
+	}
+	if (powered) {
+		io->write(io->context, PGPU_AHB_CBCR, gate | PGPU_AHB_ON);
+		bool settled = pgpu_ahb_gate_settled(io, true);
+		if (settled) {
+			if (observe) {
+				observe(observe_ctx);
+			}
+			unsigned hold = hold_ms > 200 ? 200 : hold_ms;
+			for (unsigned i = 0; i < hold * 10; ++i) {
+				io->delay_us(100);
+			}
+		}
+		io->write(io->context, PGPU_AHB_CBCR, gate);
+		if (!pgpu_ahb_gate_settled(io, false)) {
+			return PGPU_CLOCK_AHB_RESTORE_TIMEOUT;
+		}
+		/* A no records only when the enable readback did not come; every
+		 * other piece of state is already restored here. */
+		if (!settled) {
+			gate_leg = false;
+		}
+	}
+	io->write(io->context, PGPU_CX_GDSCR, cx | PGPU_COLLAPSE);
+	if (!pgpu_power_wait(io, false) ||
+	    !pgpu_collapsed(io->read(io->context, PGPU_CX_GDSCR))) {
+		return PGPU_CLOCK_OFF_TIMEOUT;
+	}
+	if (cx_final) {
+		*cx_final = io->read(io->context, PGPU_CX_GDSCR);
+	}
+	if (gx_final) {
+		*gx_final = io->read(io->context, PGPU_GX_GDSCR);
+	}
+	if (ahb_final) {
+		*ahb_final = io->read(io->context, PGPU_AHB_CBCR);
+	}
+	if (!gate_leg) {
+		return PGPU_CLOCK_AHB_ON_TIMEOUT;
+	}
+	return powered ? PGPU_CLOCK_PASS : PGPU_CLOCK_ON_TIMEOUT;
+}
 #endif
