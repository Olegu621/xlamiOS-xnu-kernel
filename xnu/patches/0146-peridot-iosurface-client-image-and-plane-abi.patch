+/* iOS20H392 IOSurfaceClientWrapClientImage sends selector6, a32-byte
+ * image range, and expects a real lock result. Never answer with zero maps. */
+IOReturn
+IOSurfaceRootUserClient::wrapClientImage(IOExternalMethodArguments *args)
+{
+	if (args->scalarInputCount || args->structureInputDescriptor ||
+	    !args->structureInput || args->structureInputSize != 32)
+		return kIOReturnBadArgument;
+	uint64_t address;
+	uint32_t image[6];
+	memcpy(&address, args->structureInput, 8);
+	memcpy(image, (const uint8_t *)args->structureInput + 8, sizeof(image));
+	uint32_t width=image[0], height=image[1], format=image[2], bpe=image[3], row=image[4];
+	uint64_t bytes=(uint64_t)row*height, start=address&~(uint64_t)PAGE_MASK;
+	uint64_t offset=address-start;
+	if (!address || !width || !height || width>SWEET_SURFACE_MAX_DIM ||
+	    height>SWEET_SURFACE_MAX_DIM || !bpe || bpe>16 ||
+	    (uint64_t)width*bpe>row || !bytes || bytes>SWEET_SURFACE_MAX_ALLOC ||
+	    address>UINT64_MAX-bytes || offset+bytes>SWEET_SURFACE_MAX_ALLOC)
+		return kIOReturnBadArgument;
+	uint64_t length=(offset+bytes+PAGE_MASK)&~(uint64_t)PAGE_MASK;
+	SweetSurface *s=sweet_surface_alloc();
+	if (!s) return kIOReturnNoMemory;
+	if ((uint64_t)OSAddAtomic64(length,(volatile SInt64 *)&sweet_surface_wired)+length>
+	    SWEET_SURFACE_WIRED_MAX) {
+		OSAddAtomic64(-(SInt64)length,(volatile SInt64 *)&sweet_surface_wired);
+		s->release();return kIOReturnNoMemory;
+	}
+	IOMemoryDescriptor *memory=IOMemoryDescriptor::withAddressRange(start,length,kIODirectionInOut,fTask);
+	if (memory && memory->prepare()!=kIOReturnSuccess) OSSafeReleaseNULL(memory);
+	if (!memory) {
+		memory=IOMemoryDescriptor::withAddressRange(start,length,kIODirectionOut,fTask);
+		if (memory && memory->prepare()!=kIOReturnSuccess) OSSafeReleaseNULL(memory);
+		s->readOnly=memory!=NULL;
+	}
+	if (!memory) {
+		OSAddAtomic64(-(SInt64)length,(volatile SInt64 *)&sweet_surface_wired);
+		s->release();return kIOReturnVMError;
+	}
+	s->memory=memory;s->clientMemory=true;s->mapCache=kIOMapDefaultCache;
+	s->width=width;s->height=height;s->pixelFormat=format;
+	s->bytesPerRow=row;s->bytesPerElement=(uint16_t)bpe;
+	s->elementWidth=s->elementHeight=1;s->planeCount=0;
+	s->offset=(uint32_t)offset;s->allocSize=(uint32_t)length;
+	if (!sweet_surface_publish(s)) {s->release();return kIOReturnNoResources;}
+	IOReturn result=returnSurface(s,args);
+	static unsigned logged;
+	if (logged++<16 || result!=kIOReturnSuccess)
+		IOLog("PERIDOT SURF: client image id=%u %ux%u format=%#x row=%u flags=%#x readonly=%u result=%#x\n",
+		    s->id,width,height,format,row,image[5],s->readOnly,result);
+	s->release();return result;
+}
