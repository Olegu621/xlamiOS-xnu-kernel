+/* Build and walk inactive native4K tables over owned physical allocations. */
+#include <IOKit/IOLib.h>
+#include "peridot_smmu4k.c"
+static void
+pgpu_prepare_tables(void)
+{
+    IOPhysicalAddress pool_pa = 0, data_pa = 0;
+    const vm_size_t bytes = 0x4000;
+    uint64_t *pool = IOMallocContiguous(bytes, bytes, &pool_pa);
+    void *data = IOMallocContiguous(bytes, bytes, &data_pa);
+    if (!pool || !data) {
+        printf("PERIDOT GPU: native4K allocation failed\n");
+        goto out;
+    }
+    bzero(pool, bytes);
+    bzero(data, bytes);
+    ArmSmmu4KConfig config = {32, 36, pool_pa, 4};
+    ArmSmmu4KRange range = {0x4000, data_pa, bytes,
+        ArmSmmu4KRead | ArmSmmu4KWrite, 0, 3};
+    ArmSmmu4KResult result;
+    ArmSmmu4KStatus status = ArmSmmu4KBuild(&config, &range, 1, pool, 4, &result);
+    bool valid = status == ArmSmmu4KSuccess;
+    for (unsigned page = 0; valid && page < 4; ++page) {
+        uint64_t iova = 0x4000 + page * 4096, table = result.root_physical;
+        for (unsigned level = result.start_level; level < 4; ++level) {
+            if (table < pool_pa || table - pool_pa > bytes - 4096) {
+                valid = false;
+                break;
+            }
+            unsigned shift = 12 + 9 * (3 - level);
+            uint64_t *entries = (uint64_t *)((char *)pool + (table - pool_pa));
+            uint64_t desc = entries[(iova >> shift) & 511];
+            if ((desc & 3) != 3) { valid = false; break; }
+            table = desc & UINT64_C(0x0000fffffffff000);
+            if (level == 3 && table != data_pa + page * 4096) valid = false;
+        }
+    }
+    printf("PERIDOT GPU: native4K inactive tables status=%u walk=%u pages=%lu leaves=%lu; no SMMU installation\n",
+        (unsigned)status, valid, (unsigned long)result.table_pages,
+        (unsigned long)result.leaf_pages);
+out:
+    /* No device ever receives these addresses, so both allocations can retire. */
+    if (data) IOFreeContiguous(data, bytes);
+    if (pool) IOFreeContiguous(pool, bytes);
+}
 
