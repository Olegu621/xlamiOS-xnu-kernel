--- /dev/null
+++ b/iokit/Kernel/arm/SweetDisplayGeometry.h
@@ -0,0 +1,93 @@
+/* Shared panel presentation and inverse touch geometry. No IOKit dependency. */
+#ifndef SWEET_DISPLAY_GEOMETRY_H
+#define SWEET_DISPLAY_GEOMETRY_H
+#include <stdint.h>
+
+static inline bool
+sweet_display_scale_default(uint32_t width, uint32_t height)
+{
+	return width == 1220 && height == 2712;
+}
+
+/* Pixel used by the presenter and by the digitizer's inverse map. */
+static inline uint32_t
+sweet_display_logical_pixel(uint32_t pixel, uint32_t physical, uint32_t logical)
+{
+	if (!physical || !logical) {
+		return 0;
+	}
+	if (pixel >= physical) {
+		pixel = physical - 1;
+	}
+	return (uint32_t)((uint64_t)pixel * logical / physical);
+}
+
+struct sweet_display_buffer {
+	uint8_t *pixels;
+	uint32_t width, height, stride;
+	uint64_t bytes, offset;
+};
+struct sweet_display_rect { int32_t x, y, width, height; };
+
+static inline bool
+sweet_display_buffer_valid(const struct sweet_display_buffer *b)
+{
+	if (!b || !b->pixels || !b->width || !b->height ||
+	    b->width > 16384 || b->height > 16384 || (b->stride & 3) ||
+	    ((uintptr_t)b->pixels & 3) || (b->offset & 3) ||
+	    b->stride < (uint64_t)b->width * 4 || b->offset > b->bytes) {
+		return false;
+	}
+	return (uint64_t)(b->height - 1) * b->stride + (uint64_t)b->width * 4 <=
+	       b->bytes - b->offset;
+}
+
+/* Nearest-neighbour scaling of a logical layer into the physical panel.
+ * Clip destination rectangles in logical space; source bounds and memory
+ * lengths are checked before any pixel is touched. Columns are private
+ * work-loop scratch, allocated once rather than on the kernel stack. */
+static inline bool
+sweet_display_scale_blit(const struct sweet_display_buffer *dst,
+    const struct sweet_display_buffer *src, uint32_t logical_w, uint32_t logical_h,
+    struct sweet_display_rect from, struct sweet_display_rect to,
+    uint32_t *columns, uint32_t capacity)
+{
+	if (!sweet_display_buffer_valid(dst) || !sweet_display_buffer_valid(src) ||
+	    dst->pixels == src->pixels || !columns || capacity < dst->width ||
+	    !logical_w || !logical_h || logical_w > 16384 || logical_h > 16384 ||
+	    from.x < 0 || from.y < 0 || from.width <= 0 || from.height <= 0 ||
+	    (int64_t)from.x + from.width > src->width ||
+	    (int64_t)from.y + from.height > src->height || to.width <= 0 || to.height <= 0) {
+		return false;
+	}
+	int64_t left = to.x < 0 ? 0 : to.x;
+	int64_t top = to.y < 0 ? 0 : to.y;
+	int64_t right = (int64_t)to.x + to.width;
+	int64_t bottom = (int64_t)to.y + to.height;
+	right = right > logical_w ? logical_w : right;
+	bottom = bottom > logical_h ? logical_h : bottom;
+	if (left >= right || top >= bottom) {
+		return true;
+	}
+	uint32_t x0 = (uint32_t)((left * dst->width + logical_w - 1) / logical_w);
+	uint32_t x1 = (uint32_t)((right * dst->width + logical_w - 1) / logical_w);
+	uint32_t y0 = (uint32_t)((top * dst->height + logical_h - 1) / logical_h);
+	uint32_t y1 = (uint32_t)((bottom * dst->height + logical_h - 1) / logical_h);
+	for (uint32_t x = x0; x < x1; ++x) {
+		uint32_t lx = sweet_display_logical_pixel(x, dst->width, logical_w);
+		columns[x] = (uint32_t)from.x + (uint32_t)(
+		    (uint64_t)((int64_t)lx - to.x) * (uint32_t)from.width / (uint32_t)to.width);
+	}
+	for (uint32_t y = y0; y < y1; ++y) {
+		uint32_t ly = sweet_display_logical_pixel(y, dst->height, logical_h);
+		uint32_t sy = (uint32_t)from.y + (uint32_t)(
+		    (uint64_t)((int64_t)ly - to.y) * (uint32_t)from.height / (uint32_t)to.height);
+		const uint32_t *in = (const uint32_t *)(src->pixels + src->offset + (uint64_t)sy * src->stride);
+		uint32_t *out = (uint32_t *)(dst->pixels + dst->offset + (uint64_t)y * dst->stride);
+		for (uint32_t x = x0; x < x1; ++x) {
+			out[x] = in[columns[x]];
+		}
+	}
+	return true;
+}
+#endif
