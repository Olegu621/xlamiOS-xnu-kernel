+
+/* Mode6 stage. Holds the previously collapsed CX domain live, programs the
+ * hub RCG exactly like mode4, and takes one control attempt on the
+ * configuration AHB gate (0x90c8) while GX is still collapsed. Then it
+ * powers the GX domain through its own GDSCR (0x9034, SW_COLLAPSE only),
+ * repeats the same gate attempt with GX live, and finally restores the
+ * gate, the hub RCG, GX and CX in that order. The AHB gate and the cxo-aon
+ * branch both refused to latch in 0115-0117 while a HALT-class sibling did
+ * latch, so the working hypothesis is that these flops sit in the GX rail
+ * and cannot be clocked until that domain is up. Powering GX is observed
+ * through the same bit31 power status used for CX, read from both the GX
+ * GDSCR itself and the GX domain status at 0x9504; either one setting is
+ * accepted, and the pair is printed so the semantics become explicit.
+ * No GPU core, GMU or SMMU register is touched: a gate latch is the only
+ * claim this stage can make. Same hard bounds as the earlier stages:
+ * bounded 50ms waits, restore-on-timeout, and leave for the diagnostic
+ * reset when a restore does not verify.
+ */
+#define PGPU_GX_DOMAIN 0x9504u
+
+struct pgpu_gx_probe {
+	uint32_t gx_before;
+	uint32_t gx_after;
+	uint32_t gxdom_before;
+	uint32_t gxdom_after;
+	uint32_t ahb_cx_during;
+	uint32_t ahb_gx_during;
+	bool powered;
+	bool ahb_cx_latched;
+	bool ahb_gx_latched;
+	bool restored;
+};
+
+/* Bounded50ms wait for the GX power status; bit31 of either the domain
+ * status or the GDSCR itself counts as powered. */
+static inline bool
+pgpu_gx_power_wait(const struct pgpu_power_io *io, bool on)
+{
+	for (unsigned i = 0; i < 500; ++i) {
+		io->delay_us(100);
+		uint32_t dom = io->read(io->context, PGPU_GX_DOMAIN);
+		uint32_t gdscr = io->read(io->context, PGPU_GX_GDSCR);
+		if (dom == UINT32_MAX || gdscr == UINT32_MAX) {
+			return false;
+		}
+		if ((((dom | gdscr) & PGPU_ON) != 0) == on) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static inline void
+pgpu_gx_snapshot(const struct pgpu_power_io *io, uint32_t *cx_final,
+    uint32_t *gx_final, uint32_t *ahb_final, uint32_t *gxdom_final,
+    uint32_t *hub_cfg_final)
+{
+	if (cx_final) {
+		*cx_final = io->read(io->context, PGPU_CX_GDSCR);
+	}
+	if (gx_final) {
+		*gx_final = io->read(io->context, PGPU_GX_GDSCR);
+	}
+	if (ahb_final) {
+		*ahb_final = io->read(io->context, PGPU_AHB_CBCR);
+	}
+	if (gxdom_final) {
+		*gxdom_final = io->read(io->context, PGPU_GX_DOMAIN);
+	}
+	if (hub_cfg_final) {
+		*hub_cfg_final = io->read(io->context, PGPU_HUB_RCG_CFG);
+	}
+}
+
+/* observe, when non-NULL, runs after CX power-on, after the hub update, and
+ * once more while GX is live. */
+static inline enum pgpu_clock_result
+pgpu_cx_hub_gx_ahb_stage(const struct pgpu_power_io *io,
+    struct pgpu_gx_probe *probe, uint32_t *cx_final, uint32_t *gx_final,
+    uint32_t *ahb_final, uint32_t *gxdom_final, uint32_t *hub_cfg_final,
+    void *observe_ctx, void (*observe)(void *observe_ctx))
+{
+	uint32_t cx = io->read(io->context, PGPU_CX_GDSCR);
+	uint32_t hw = io->read(io->context, PGPU_CX_HW);
+	uint32_t gx = io->read(io->context, PGPU_GX_GDSCR);
+	uint32_t gxdom = io->read(io->context, PGPU_GX_DOMAIN);
+	if (!pgpu_collapsed(cx) || !pgpu_collapsed(gx) || (gx & PGPU_ON) ||
+	    hw == UINT32_MAX || (hw & PGPU_ON) ||
+	    gxdom == UINT32_MAX || (gxdom & PGPU_ON)) {
+		return PGPU_CLOCK_REFUSED;
+	}
+	uint32_t gate = io->read(io->context, PGPU_AHB_CBCR);
+	if (gate == UINT32_MAX || (gate & ~PGPU_AHB_KNOWN) ||
+	    (gate & PGPU_AHB_ON)) {
+		return PGPU_CLOCK_REFUSED;
+	}
+	uint32_t hub_cmd = io->read(io->context, PGPU_HUB_RCG_CMD);
+	uint32_t hub_cfg = io->read(io->context, PGPU_HUB_RCG_CFG);
+	if (hub_cmd == UINT32_MAX || hub_cfg == UINT32_MAX ||
+	    (hub_cmd & ~PGPU_RCG_CMD_KNOWN) ||
+	    (hub_cmd & (PGPU_RCG_CMD_UPDATE | PGPU_RCG_CMD_DIRTY |
+	    PGPU_RCG_CMD_ROOT_OFF)) ||
+	    (hub_cfg & (uint32_t)~PGPU_HUB_CFG_KNOWN) ||
+	    (hub_cfg & PGPU_HUB_CFG_HW_CTRL)) {
+		return PGPU_CLOCK_REFUSED;
+	}
+	probe->gx_before = gx;
+	probe->gxdom_before = gxdom;
+	io->write(io->context, PGPU_CX_GDSCR, cx & ~PGPU_COLLAPSE);
+	bool powered = pgpu_power_wait(io, true);
+	cx = io->read(io->context, PGPU_CX_GDSCR);
+	gx = io->read(io->context, PGPU_GX_GDSCR);
+	if (cx == UINT32_MAX || (cx & (PGPU_HW_CONTROL | PGPU_OVERRIDE)) ||
+	    !pgpu_collapsed(gx)) {
+		return PGPU_CLOCK_OWNERSHIP_LOST;
+	}
+	if (powered) {
+		if (observe) {
+			observe(observe_ctx);
+		}
+		io->write(io->context, PGPU_HUB_RCG_CFG, PGPU_HUB_CFG_PROGRAM);
+		io->write(io->context, PGPU_HUB_RCG_CMD,
+		    hub_cmd | PGPU_RCG_CMD_UPDATE);
+		bool hub_ok = pgpu_rcg_update_settled(io, PGPU_HUB_RCG_CMD) &&
+		    io->read(io->context, PGPU_HUB_RCG_CFG) ==
+		    PGPU_HUB_CFG_PROGRAM;
+		if (observe) {
+			observe(observe_ctx);
+		}
+		if (!hub_ok) {
+			io->write(io->context, PGPU_HUB_RCG_CFG, hub_cfg);
+			io->write(io->context, PGPU_HUB_RCG_CMD,
+			    hub_cmd | PGPU_RCG_CMD_UPDATE);
+			(void)pgpu_rcg_update_settled(io, PGPU_HUB_RCG_CMD);
+			bool hub_back =
+			    io->read(io->context, PGPU_HUB_RCG_CFG) == hub_cfg;
+			io->write(io->context, PGPU_CX_GDSCR,
+			    cx | PGPU_COLLAPSE);
+			bool cx_back = pgpu_power_wait(io, false) &&
+			    pgpu_collapsed(io->read(io->context,
+			    PGPU_CX_GDSCR));
+			pgpu_gx_snapshot(io, cx_final, gx_final, ahb_final,
+			    gxdom_final, hub_cfg_final);
+			if (!hub_back) {
+				return PGPU_CLOCK_HUB_RESTORE_TIMEOUT;
+			}
+			if (!cx_back) {
+				return PGPU_CLOCK_OFF_TIMEOUT;
+			}
+			return PGPU_CLOCK_HUB_UPDATE_TIMEOUT;
+		}
+		io->write(io->context, PGPU_AHB_CBCR, gate | PGPU_AHB_ON);
+		probe->ahb_cx_latched = pgpu_ahb_gate_settled(io, true);
+		probe->ahb_cx_during = io->read(io->context, PGPU_AHB_CBCR);
+		io->write(io->context, PGPU_AHB_CBCR, gate);
+		if (!pgpu_ahb_gate_settled(io, false)) {
+			return PGPU_CLOCK_AHB_RESTORE_TIMEOUT;
+		}
+		io->write(io->context, PGPU_GX_GDSCR, gx & ~PGPU_COLLAPSE);
+		probe->powered = pgpu_gx_power_wait(io, true);
+		if (!probe->powered) {
+			probe->gx_after = io->read(io->context, PGPU_GX_GDSCR);
+			probe->gxdom_after =
+			    io->read(io->context, PGPU_GX_DOMAIN);
+			io->write(io->context, PGPU_HUB_RCG_CFG, hub_cfg);
+			io->write(io->context, PGPU_HUB_RCG_CMD,
+			    hub_cmd | PGPU_RCG_CMD_UPDATE);
+			(void)pgpu_rcg_update_settled(io, PGPU_HUB_RCG_CMD);
+			bool hub_back =
+			    io->read(io->context, PGPU_HUB_RCG_CFG) == hub_cfg;
+			io->write(io->context, PGPU_GX_GDSCR, gx);
+			probe->restored = pgpu_gx_power_wait(io, false);
+			io->write(io->context, PGPU_CX_GDSCR,
+			    cx | PGPU_COLLAPSE);
+			bool cx_back = pgpu_power_wait(io, false) &&
+			    pgpu_collapsed(io->read(io->context,
+			    PGPU_CX_GDSCR));
+			pgpu_gx_snapshot(io, cx_final, gx_final, ahb_final,
+			    gxdom_final, hub_cfg_final);
+			if (!hub_back) {
+				return PGPU_CLOCK_HUB_RESTORE_TIMEOUT;
+			}
+			if (!probe->restored) {
+				return PGPU_CLOCK_GX_OFF_TIMEOUT;
+			}
+			if (!cx_back) {
+				return PGPU_CLOCK_OFF_TIMEOUT;
+			}
+			return PGPU_CLOCK_GX_ON_TIMEOUT;
+		}
+		if (observe) {
+			observe(observe_ctx);
+		}
+		io->write(io->context, PGPU_AHB_CBCR, gate | PGPU_AHB_ON);
+		probe->ahb_gx_latched = pgpu_ahb_gate_settled(io, true);
+		probe->ahb_gx_during = io->read(io->context, PGPU_AHB_CBCR);
+		io->write(io->context, PGPU_AHB_CBCR, gate);
+		if (!pgpu_ahb_gate_settled(io, false)) {
+			return PGPU_CLOCK_AHB_RESTORE_TIMEOUT;
+		}
+		io->write(io->context, PGPU_HUB_RCG_CFG, hub_cfg);
+		io->write(io->context, PGPU_HUB_RCG_CMD,
+		    hub_cmd | PGPU_RCG_CMD_UPDATE);
+		(void)pgpu_rcg_update_settled(io, PGPU_HUB_RCG_CMD);
+		if (io->read(io->context, PGPU_HUB_RCG_CFG) != hub_cfg) {
+			return PGPU_CLOCK_HUB_RESTORE_TIMEOUT;
+		}
+		io->write(io->context, PGPU_GX_GDSCR, gx);
+		probe->restored = pgpu_gx_power_wait(io, false);
+		probe->gx_after = io->read(io->context, PGPU_GX_GDSCR);
+		probe->gxdom_after = io->read(io->context, PGPU_GX_DOMAIN);
+		if (!probe->restored) {
+			return PGPU_CLOCK_GX_OFF_TIMEOUT;
+		}
+	}
+	io->write(io->context, PGPU_CX_GDSCR, cx | PGPU_COLLAPSE);
+	if (!pgpu_power_wait(io, false) ||
+	    !pgpu_collapsed(io->read(io->context, PGPU_CX_GDSCR))) {
+		return PGPU_CLOCK_OFF_TIMEOUT;
+	}
+	pgpu_gx_snapshot(io, cx_final, gx_final, ahb_final, gxdom_final,
+	    hub_cfg_final);
+	if (!powered) {
+		return PGPU_CLOCK_ON_TIMEOUT;
+	}
+	if (!probe->ahb_gx_latched) {
+		return PGPU_CLOCK_AHB_ON_TIMEOUT;
+	}
+	return PGPU_CLOCK_PASS;
+}
 #endif
