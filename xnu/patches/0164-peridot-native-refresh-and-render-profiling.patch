+/* Opt-in read-only measurement of the exact selected n16t42 panel handoff.
+ * Live FDT: DSI0 ae94000/1000, its mdp_intf_base ae36000/300.
+ * Offsets match Qualcomm dsi_ctrl_reg.h and sde_hw_intf.c. */
+static uint32_t
+sweet_fb_mmio_read(uintptr_t base, uint32_t offset)
+{
+	uint32_t value;
+	__asm__ volatile("ldr %w0, [%1]" : "=r"(value) : "r"(base + offset) : "memory");
+	return value;
+}
+
+static void
+sweet_fb_panel_probe(void)
+{
+	IOMemoryDescriptor *dsi = IOMemoryDescriptor::withPhysicalAddress(0xae94000, 0x1000, kIODirectionInOut);
+	IOMemoryDescriptor *intf = IOMemoryDescriptor::withPhysicalAddress(0xae36000, 0x300, kIODirectionInOut);
+	IOMemoryMap *dm = dsi ? dsi->map(kIOMapReadOnly | kIOMapInhibitCache) : NULL;
+	IOMemoryMap *im = intf ? intf->map(kIOMapReadOnly | kIOMapInhibitCache) : NULL;
+	if (dm && im) {
+		uintptr_t d = dm->getVirtualAddress(), i = im->getVirtualAddress();
+		uint32_t control = sweet_fb_mmio_read(d, 0x04);
+		uint32_t active = sweet_fb_mmio_read(d, 0x28);
+		uint32_t total = sweet_fb_mmio_read(d, 0x2c);
+		uint32_t compression = sweet_fb_mmio_read(d, 0x2a0);
+		uint32_t enabled = sweet_fb_mmio_read(i, 0x00);
+		uint32_t first = sweet_fb_mmio_read(i, 0xac);
+		uint64_t begin = mach_absolute_time();
+		IOSleep(200);
+		uint32_t last = sweet_fb_mmio_read(i, 0xac);
+		uint64_t elapsed;
+		absolutetime_to_nanoseconds(mach_absolute_time() - begin, &elapsed);
+		uint32_t frames = last - first;
+		IOLog("PERIDOT PANEL RO: DSI0 ctrl=0x%x active_v=0x%x total=0x%x compression=0x%x INTF1 enable=0x%x frames=%u/%u delta=%u elapsed_ns=%llu rate_mHz=%llu\n",
+		    control, active, total, compression, enabled, first, last, frames, elapsed,
+		    elapsed && frames <= 1000 ? (uint64_t)frames * 1000000000000ULL / elapsed : 0ULL);
+	} else {
+		IOLog("PERIDOT PANEL RO: mapping unavailable, no register access performed\n");
+	}
+	OSSafeReleaseNULL(dm); OSSafeReleaseNULL(im);
+	OSSafeReleaseNULL(dsi); OSSafeReleaseNULL(intf);
+}
 
