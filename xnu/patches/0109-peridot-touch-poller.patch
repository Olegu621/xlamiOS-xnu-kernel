+/* ---- touch polling over the bit-banged SPI ---------------------------------- */
+
+#define TP_TOUCH_MAX 10
+#define TP_FRAME_LEN 90u
+static uint32_t tp_touch_addr;
+static bool tp_down[TP_TOUCH_MAX];
+static int tp_x[TP_TOUCH_MAX], tp_y[TP_TOUCH_MAX];
+static int tp_sleep_chan;
+
+/* The only device write: acknowledge the verified event-status byte. */
+static bool
+tp_ack(void)
+{
+	memset(tp_tx, 0, 5);
+	tp_tx[0] = 0xf0;
+	for (unsigned i = 0; i < 4; ++i) {
+		tp_tx[i + 1] = (uint8_t)(tp_touch_addr >> (24 - 8 * i));
+	}
+	return tp_transfer(5);
+}
+
+static void
+tp_release(void)
+{
+	for (unsigned i = 0; i < TP_TOUCH_MAX; ++i) {
+		if (tp_down[i]) {
+			sweet_hid_touch((int)i, 0, tp_x[i], tp_y[i]);
+			tp_down[i] = false;
+		}
+	}
+}
+
+/* Validate a complete frame before changing HID state. Unknown variable-size
+ * pen or key records are rejected, never interpreted with a finger stride. */
+static bool
+tp_decode(const uint8_t *b, unsigned len, bool seen[TP_TOUCH_MAX],
+    int x[TP_TOUCH_MAX], int y[TP_TOUCH_MAX])
+{
+	if (len < 8 || !(b[0] & 0x80) || !tp_checksum(b, 8)) {
+		return false;
+	}
+	unsigned n = b[2] & 15;
+	if (n > TP_TOUCH_MAX || (b[3] & 0x10) || len < 8 + n * 8 + (n ? 2 : 0) ||
+	    (n && !tp_checksum(b + 8, n * 8 + 2))) {
+		return false;
+	}
+	memset(seen, 0, TP_TOUCH_MAX * sizeof(*seen));
+	for (unsigned i = 0; i < n; ++i) {
+		const uint8_t *p = b + 8 + i * 8;
+		unsigned id = p[0] >> 4, type = p[0] & 15;
+		unsigned rawx = p[2] | p[3] << 8, rawy = p[4] | p[5] << 8;
+		if ((type != 0 && type != 2) || id >= TP_TOUCH_MAX || seen[id] ||
+		    rawx > 19520 || rawy > 43392) {
+			return false;
+		}
+		seen[id] = true;
+		x[id] = (int)(rawx / 16);
+		y[id] = (int)(rawy / 16);
+	}
+	return true;
+}
+
+static void
+tp_poll_thread(__unused void *arg, __unused wait_result_t result)
+{
+	uint8_t header[8], frame[TP_FRAME_LEN];
+	unsigned drops = 0, reports = 0;
+
+	for (;;) {
+		/* The status byte is the first byte of the report, so a short
+		 * read tells us whether there is anything new at all. */
+		if (tp_read(tp_touch_addr, header, sizeof(header)) && (header[0] & 0x80)) {
+			bool seen[TP_TOUCH_MAX];
+			int x[TP_TOUCH_MAX], y[TP_TOUCH_MAX];
+
+			if (!tp_read(tp_touch_addr, frame, sizeof(frame))) {
+				if (drops++ < 4) {
+					printf("PERIDOT TOUCH: frame read failed\n");
+				}
+			} else {
+				bool valid = tp_decode(frame, sizeof(frame), seen, x, y);
+				/* Acknowledge only after the frame was copied: a
+				 * failed ACK cannot leave contacts stuck. */
+				if (!tp_ack()) {
+					printf("PERIDOT TOUCH: event ACK failed; poller stopped\n");
+					break;
+				}
+				if (valid) {
+					reports++;
+					for (unsigned i = 0; i < TP_TOUCH_MAX; ++i) {
+						if (seen[i]) {
+							tp_x[i] = x[i];
+							tp_y[i] = y[i];
+							sweet_hid_touch((int)i, 1, x[i], y[i]);
+						} else if (tp_down[i]) {
+							sweet_hid_touch((int)i, 0, tp_x[i], tp_y[i]);
+						}
+						tp_down[i] = seen[i];
+					}
+				} else {
+					tp_release();
+					if (drops++ < 4) {
+						printf("PERIDOT TOUCH: dropped frame status=%#x count=%u\n",
+						    frame[0], frame[2] & 15);
+					}
+				}
+			}
+		}
+		uint64_t deadline;
+		clock_interval_to_deadline(8, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline(&tp_sleep_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+	printf("PERIDOT TOUCH: poller stopped after %u reports, %u dropped frames\n",
+	    reports, drops);
+	tp_release();
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
