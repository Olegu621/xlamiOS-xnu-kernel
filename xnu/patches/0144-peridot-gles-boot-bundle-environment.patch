+extern const char *peridot_gles_library(void);
+/* iOS dyld's policy query for the explicitly staged graphics-server image.
+ * Page/code-directory validation remains in the existing signature path. */
+static int
+peridot_amfi_dyld_syscall(struct proc *p, int call, user_addr_t argument)
+{
+    if (call!=0x5a || !p || !peridot_gles_library()) return ENOPOLICY;
+    char name[32]={0};
+    proc_name(proc_pid(p),name,sizeof(name));
+    if (strcmp(name,"backboardd")) return ENOPOLICY;
+    uint64_t args[2],flags=0x7b;
+    if (copyin(argument,args,sizeof(args)) || !args[1]) return EFAULT;
+    return copyout(&flags,(user_addr_t)args[1],sizeof(flags));
+}
