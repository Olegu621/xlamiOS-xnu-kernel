+
+/* Mode4 stage. Holds the previously collapsed CX domain live, programs the
+ * hub RCG (0x919c cmd / 0x91a0 cfg) to the only DT frequency (200 MHz from
+ * GPLL0_OUT_MAIN divided by3), then retries the configuration AHB gate
+ * (0x90c8). The gate's parent is this RCG (MiCode gpucc-cliffs.c), the 0115
+ * gate write never read back, and the RCG had never been updated before
+ * (cmd and cfg read0 at handoff). observe, when non-NULL, runs while CX is
+ * live before any clock write and again after the hub update, so the full
+ * inventory is captured even when the gate still refuses. Refuse unreadable
+ * or unknown gate/RCG state, a busy RCG (update or dirty bits), a parked
+ * RCG (ROOT_OFF), and a hardware-controlled cfg. Restore order is gate,
+ * RCG, then CX. Same hard bounds as the power stage: bounded 50ms branch
+ * waits, a bounded update poll, restore-on-timeout, and leave for the
+ * diagnostic reset when a restore or ownership fails. No GMU, GPU core or
+ * SMMU access, no other gates, RCGs, votes or resets, and no firmware.
+ */
+#define PGPU_HUB_RCG_CMD 0x919cu
+#define PGPU_HUB_RCG_CFG 0x91a0u
+#define PGPU_HUB_CFG_PROGRAM ((5u << 8) | 3u)	/* GPLL0_OUT_MAIN / 3 */
+#define PGPU_HUB_CFG_DIV_MASK 0x1fu
+#define PGPU_HUB_CFG_SEL_MASK (7u << 8)
+#define PGPU_HUB_CFG_MODE_MASK (3u << 12)
+#define PGPU_HUB_CFG_HW_CTRL (1u << 20)
+#define PGPU_HUB_CFG_KNOWN \
+	(PGPU_HUB_CFG_DIV_MASK | PGPU_HUB_CFG_SEL_MASK | \
+	PGPU_HUB_CFG_MODE_MASK | PGPU_HUB_CFG_HW_CTRL)
+#define PGPU_RCG_CMD_UPDATE 1u
+#define PGPU_RCG_CMD_ROOT_EN 2u
+#define PGPU_RCG_CMD_DIRTY 0xf0u
+#define PGPU_RCG_CMD_ROOT_OFF (1u << 31)
+#define PGPU_RCG_CMD_KNOWN \
+	(PGPU_RCG_CMD_UPDATE | PGPU_RCG_CMD_ROOT_EN | PGPU_RCG_CMD_DIRTY | \
+	PGPU_RCG_CMD_ROOT_OFF)
+
+/* qcom update_config: the UPDATE bit self-clears once the new divider and
+ * source latch; upstream bounds this at500us, keep a wider10ms here. */
+static inline bool
+pgpu_rcg_update_settled(const struct pgpu_power_io *io, unsigned cmd_off)
+{
+	for (unsigned i = 0; i < 100; ++i) {
+		io->delay_us(100);
+		uint32_t cmd = io->read(io->context, cmd_off);
+		if (cmd == UINT32_MAX) {
+			return false;
+		}
+		if ((cmd & PGPU_RCG_CMD_UPDATE) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* Restoring means the cfg register reads back the original value again; the
+ * update trigger is best effort because a failed latch of the original value
+ * cannot be distinguished from a hardware that ignores triggers, and the
+ * diagnostic reset follows anyway. */
+static inline enum pgpu_clock_result
+pgpu_cx_hold_hub_ahb_stage(const struct pgpu_power_io *io, unsigned hold_ms,
+    uint32_t *cx_final, uint32_t *gx_final, uint32_t *ahb_final,
+    uint32_t *hub_cfg_final, uint32_t *hub_cmd_final,
+    void *observe_ctx, void (*observe)(void *observe_ctx))
+{
+	uint32_t cx = io->read(io->context, PGPU_CX_GDSCR);
+	uint32_t hw = io->read(io->context, PGPU_CX_HW);
+	uint32_t gx = io->read(io->context, PGPU_GX_GDSCR);
+	if (!pgpu_collapsed(cx) || !pgpu_collapsed(gx) ||
+	    hw == UINT32_MAX || (hw & PGPU_ON)) {
+		return PGPU_CLOCK_REFUSED;
+	}
+	uint32_t gate = io->read(io->context, PGPU_AHB_CBCR);
+	if (gate == UINT32_MAX || (gate & ~PGPU_AHB_KNOWN) ||
+	    (gate & PGPU_AHB_ON)) {
+		return PGPU_CLOCK_REFUSED;
+	}
+	uint32_t hub_cmd = io->read(io->context, PGPU_HUB_RCG_CMD);
+	uint32_t hub_cfg = io->read(io->context, PGPU_HUB_RCG_CFG);
+	if (hub_cmd == UINT32_MAX || hub_cfg == UINT32_MAX ||
+	    (hub_cmd & ~PGPU_RCG_CMD_KNOWN) ||
+	    (hub_cmd & (PGPU_RCG_CMD_UPDATE | PGPU_RCG_CMD_DIRTY |
+	    PGPU_RCG_CMD_ROOT_OFF)) ||
+	    (hub_cfg & (uint32_t)~PGPU_HUB_CFG_KNOWN) ||
+	    (hub_cfg & PGPU_HUB_CFG_HW_CTRL)) {
+		return PGPU_CLOCK_REFUSED;
+	}
+	io->write(io->context, PGPU_CX_GDSCR, cx & ~PGPU_COLLAPSE);
+	bool powered = pgpu_power_wait(io, true);
+	bool hub_ok = false;
+	bool gate_leg = true;
+	cx = io->read(io->context, PGPU_CX_GDSCR);
+	gx = io->read(io->context, PGPU_GX_GDSCR);
+	if (cx == UINT32_MAX || (cx & (PGPU_HW_CONTROL | PGPU_OVERRIDE)) ||
+	    !pgpu_collapsed(gx)) {
+		return PGPU_CLOCK_OWNERSHIP_LOST;
+	}
+	if (powered) {
+		if (observe) {
+			observe(observe_ctx);
+		}
+		io->write(io->context, PGPU_HUB_RCG_CFG, PGPU_HUB_CFG_PROGRAM);
+		io->write(io->context, PGPU_HUB_RCG_CMD,
+		    hub_cmd | PGPU_RCG_CMD_UPDATE);
+		hub_ok = pgpu_rcg_update_settled(io, PGPU_HUB_RCG_CMD) &&
+		    io->read(io->context, PGPU_HUB_RCG_CFG) ==
+		    PGPU_HUB_CFG_PROGRAM;
+		if (observe) {
+			observe(observe_ctx);
+		}
+		if (hub_ok) {
+			io->write(io->context, PGPU_AHB_CBCR, gate | PGPU_AHB_ON);
+			bool settled = pgpu_ahb_gate_settled(io, true);
+			if (settled) {
+				unsigned hold = hold_ms > 200 ? 200 : hold_ms;
+				for (unsigned i = 0; i < hold * 10; ++i) {
+					io->delay_us(100);
+				}
+			}
+			io->write(io->context, PGPU_AHB_CBCR, gate);
+			if (!pgpu_ahb_gate_settled(io, false)) {
+				return PGPU_CLOCK_AHB_RESTORE_TIMEOUT;
+			}
+			if (!settled) {
+				gate_leg = false;
+			}
+		}
+		io->write(io->context, PGPU_HUB_RCG_CFG, hub_cfg);
+		io->write(io->context, PGPU_HUB_RCG_CMD,
+		    hub_cmd | PGPU_RCG_CMD_UPDATE);
+		(void)pgpu_rcg_update_settled(io, PGPU_HUB_RCG_CMD);
+		if (io->read(io->context, PGPU_HUB_RCG_CFG) != hub_cfg) {
+			return PGPU_CLOCK_HUB_RESTORE_TIMEOUT;
+		}
+	}
+	io->write(io->context, PGPU_CX_GDSCR, cx | PGPU_COLLAPSE);
+	if (!pgpu_power_wait(io, false) ||
+	    !pgpu_collapsed(io->read(io->context, PGPU_CX_GDSCR))) {
+		return PGPU_CLOCK_OFF_TIMEOUT;
+	}
+	if (cx_final) {
+		*cx_final = io->read(io->context, PGPU_CX_GDSCR);
+	}
+	if (gx_final) {
+		*gx_final = io->read(io->context, PGPU_GX_GDSCR);
+	}
+	if (ahb_final) {
+		*ahb_final = io->read(io->context, PGPU_AHB_CBCR);
+	}
+	if (hub_cfg_final) {
+		*hub_cfg_final = io->read(io->context, PGPU_HUB_RCG_CFG);
+	}
+	if (hub_cmd_final) {
+		*hub_cmd_final = io->read(io->context, PGPU_HUB_RCG_CMD);
+	}
+	if (!powered) {
+		return PGPU_CLOCK_ON_TIMEOUT;
+	}
+	if (!hub_ok) {
+		return PGPU_CLOCK_HUB_UPDATE_TIMEOUT;
+	}
+	if (!gate_leg) {
+		return PGPU_CLOCK_AHB_ON_TIMEOUT;
+	}
+	return PGPU_CLOCK_PASS;
+}
 #endif
