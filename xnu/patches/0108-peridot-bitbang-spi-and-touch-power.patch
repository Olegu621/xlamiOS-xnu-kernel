diff --git a/bsd/dev/sweet_rpmh_peridot.c b/bsd/dev/sweet_rpmh_peridot.c
new file mode 100644
index 0000000..2d893fb
--- /dev/null
+++ b/bsd/dev/sweet_rpmh_peridot.c
@@ -0,0 +1,351 @@
+/*
+ * Peridot PMXR2230 touchscreen rails via APPS DRV2 ACTIVE TCS3/4.
+ * Sole XNU apps-DRV owner, called from thread context with deep idle disabled.
+ * No sleep/wake/control TCS programming, direct SPMI writes or timeout retry.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+int sweet_peridot_touch_rail_enable(const char *res, unsigned mv);
+
+/* Live downstream DT has two positional reg entries, no reg-names. */
+#define PR_RSC_PA       0x17a20000u
+#define PR_TCS_PA       0x17a20d00u
+#define PR_TCS_SIZE     0x3000u
+#define PR_DRV          2u
+#define PR_ACTIVE_FIRST 3u
+#define PR_ACTIVE_N     2u       /* DT order: WAKE3, ACTIVE2, SLEEP2, FAST1 */
+#define PR_NORMAL_N     8u       /* WAKE3 + ACTIVE2 + SLEEP2 + FAST1 */
+#define PR_TCS_STRIDE   0x2a0u
+#define PR_CMD_STRIDE   0x18u
+#define PR_IRQ_EN       0x00u
+#define PR_IRQ_STATUS   0x04u
+#define PR_IRQ_CLEAR    0x08u
+#define PR_WAIT         0x20u
+#define PR_CONTROL      0x24u
+#define PR_STATUS       0x28u
+#define PR_ENABLE       0x2cu
+#define PR_MSGID        0x34u
+#define PR_ADDR         0x38u
+#define PR_DATA         0x3cu
+#define PR_CMD_STATUS   0x40u
+#define PR_AMC_EN       (1u << 16)
+#define PR_TRIGGER      (1u << 24)
+#define PR_ISSUED       (1u << 8)
+#define PR_COMPLETE     (1u << 16)
+#define PR_WRITE_ACK    (8u | (1u << 8) | (1u << 16))
+#define PR_DB_MAGIC     0x0c0330dbu
+#define PR_DB_HEADER    144u
+#define PR_DB_ENTRY     24u
+#define PR_DB_MAX       0x20000u /* reserved cmd-db region from DT */
+#define PR_VRM          4u
+#define PR_TIMEOUT_US   100000u
+
+static vm_offset_t pr_rsc, pr_tcs, pr_db;
+static uint32_t pr_db_size;
+static unsigned pr_ncpt;
+static unsigned pr_lock;
+static bool pr_poisoned;
+
+static uint32_t
+pr_read(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+pr_write(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+pr_sync(uint32_t off, uint32_t value)
+{
+	pr_write(pr_tcs, off, value);
+	for (unsigned i = 0; i < 1000; ++i) {
+		if (pr_read(pr_tcs, off) == value) {
+			return true;
+		}
+		delay(1);
+	}
+	printf("PERIDOT RPMH: readback timeout off=%#x want=%#x got=%#x\n",
+	    off, value, pr_read(pr_tcs, off));
+	return false;
+}
+
+/* DB is little endian; avoid packed structs and unaligned Device loads. */
+static uint16_t
+pr_db16(uint32_t off)
+{
+	uint32_t v = pr_read(pr_db, off & ~3u);
+	return (uint16_t)(v >> (8u * (off & 3u)));
+}
+
+static bool
+pr_range(uint32_t off, uint32_t size)
+{
+	return off <= pr_db_size && size <= pr_db_size - off;
+}
+
+static int
+pr_map(void)
+{
+	if (!pr_rsc) {
+		pr_rsc = ml_io_map(PR_RSC_PA, 0x100);
+	}
+	if (!pr_tcs) {
+		pr_tcs = ml_io_map(PR_TCS_PA, PR_TCS_SIZE);
+	}
+	if (!pr_rsc || !pr_tcs) {
+		printf("PERIDOT RPMH: RSC/locator mapping failed\n");
+		return ENOMEM;
+	}
+	uint32_t id = pr_read(pr_rsc, 0);
+	uint32_t solver = pr_read(pr_rsc, 4);
+	uint32_t config = pr_read(pr_rsc, 0x0c);
+	unsigned major = (id >> 16) & 0xffu;
+	unsigned count = (config >> (6u * PR_DRV)) & 0x3fu;
+	pr_ncpt = (config >> 27) & 0x1fu;
+	printf("PERIDOT RPMH: rsc=%#x tcs=%#x DRV=%u id=%#x solver=%#x config=%#x TCS=%u ncpt=%u\n",
+	    PR_RSC_PA, PR_TCS_PA, PR_DRV, id, solver, config, count, pr_ncpt);
+	/* Exact peridot vendor v3.0 layout, including24-byte command stride. */
+	if (major != 3 || config == 0xffffffffu ||
+	    solver == 0xffffffffu || count < PR_NORMAL_N ||
+	    count > PR_TCS_SIZE / PR_TCS_STRIDE || pr_ncpt < 3 || pr_ncpt > 16) {
+		printf("PERIDOT RPMH: unsupported RSC geometry/revision\n");
+		return ENODEV;
+	}
+	if (!pr_db) {
+		/* Fixed reserved region from the live peridot DT, not a RAM scan. */
+		pr_db = ml_io_map(0x81c60000, 0x20000);
+		pr_db_size = 0x20000;
+		if (!pr_db) {
+			return ENOMEM;
+		}
+	}
+	uint32_t db_version = pr_read(pr_db, 0);
+	uint32_t magic = pr_read(pr_db, 4);
+	uint32_t flags = pr_read(pr_db, 140);
+	printf("PERIDOT RPMH: cmd-db version=%#x magic=%#x checksum=%#x flags=%#x\n",
+	    db_version, magic, pr_read(pr_db, 136), flags);
+	/* Linux only checks magic; version 1 is an intentionally stricter policy. */
+	if (magic != PR_DB_MAGIC || db_version != 1 || (flags & 1u)) {
+		printf("PERIDOT RPMH: unsupported/standalone cmd-db\n");
+		return EINVAL;
+	}
+	return 0;
+}
+
+static int
+pr_lookup(const char *res, uint32_t *address)
+{
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	unsigned matches = 0;
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = pr_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = PR_DB_HEADER + pr_db16(h + 2);
+		uint32_t aux = PR_DB_HEADER + pr_db16(h + 4);
+		unsigned count = pr_db16(h + 6);
+		if (slave < 3 || slave > 5 || (entries & 3u) ||
+		    !pr_range(entries, count * PR_DB_ENTRY) || !pr_range(aux, 0)) {
+			printf("PERIDOT RPMH: malformed cmd-db slave header %u\n", i);
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + PR_DB_ENTRY * j;
+			if (pr_read(pr_db, e) != key[0] || pr_read(pr_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = pr_read(pr_db, e + 16);
+			if (slave != PR_VRM || (addr >> 16) != PR_VRM || (addr & 15u) ||
+			    !pr_range(aux + pr_db16(e + 22), pr_db16(e + 20))) {
+				printf("PERIDOT RPMH: invalid VRM entry for %s\n", res);
+				return EINVAL;
+			}
+			*address = addr;
+			++matches;
+			printf("PERIDOT RPMH: %s addr=%#x slave=%u aux-version=%#x priority=%#x:%#x\n",
+			    res, addr, slave, pr_db16(h + 8),
+			    pr_read(pr_db, e + 8), pr_read(pr_db, e + 12));
+		}
+	}
+	if (matches != 1) {
+		printf("PERIDOT RPMH: %s lookup matches=%u; refusing\n", res, matches);
+		return ENODEV;
+	}
+	return 0;
+}
+
+static bool
+pr_free(unsigned t)
+{
+	uint32_t b = t * PR_TCS_STRIDE;
+	/* Idle alone is insufficient: a sleep/wake payload can be armed and idle. */
+	return pr_read(pr_tcs, b + PR_STATUS) != 0 &&
+	    pr_read(pr_tcs, b + PR_STATUS) != 0xffffffffu &&
+	    pr_read(pr_tcs, b + PR_CONTROL) == 0 &&
+	    pr_read(pr_tcs, b + PR_ENABLE) == 0 &&
+	    pr_read(pr_tcs, b + PR_WAIT) == 0 &&
+	    !(pr_read(pr_tcs, PR_IRQ_STATUS) & (1u << t));
+}
+
+static int
+pr_send(uint32_t address, unsigned mv)
+{
+	int chosen = -1;
+	for (unsigned t = PR_ACTIVE_FIRST; t < PR_ACTIVE_FIRST + PR_ACTIVE_N; ++t) {
+		uint32_t b = t * PR_TCS_STRIDE;
+		uint32_t enabled = pr_read(pr_tcs, b + PR_ENABLE);
+		printf("PERIDOT RPMH: ACTIVE TCS%u idle=%#x control=%#x enable=%#x wait=%#x\n",
+		    t, pr_read(pr_tcs, b + PR_STATUS), pr_read(pr_tcs, b + PR_CONTROL),
+		    enabled, pr_read(pr_tcs, b + PR_WAIT));
+		if (enabled & ~((1u << pr_ncpt) - 1u)) {
+			return EIO;
+		}
+		for (unsigned c = 0; c < pr_ncpt; ++c) {
+			if ((enabled & (1u << c)) &&
+			    (pr_read(pr_tcs, b + PR_ADDR + c * PR_CMD_STRIDE) & ~15u) == address) {
+				printf("PERIDOT RPMH: conflicting inherited touch-rail request in TCS%u\n", t);
+				return EBUSY;
+			}
+		}
+		if (chosen < 0 && pr_free(t)) {
+			chosen = (int)t;
+		}
+	}
+	if (chosen < 0) {
+		printf("PERIDOT RPMH: no empty idle ACTIVE TCS; leaving inherited state intact\n");
+		return EBUSY;
+	}
+	unsigned t = (unsigned)chosen;
+	uint32_t b = t * PR_TCS_STRIDE, bit = 1u << t;
+	uint32_t irq_en = pr_read(pr_tcs, PR_IRQ_EN);
+	if (irq_en == 0xffffffffu || !pr_free(t)) {
+		return EBUSY;
+	}
+	/* Only this TCS's source is masked. Other sources/CPU IRQs remain intact. */
+	if (!pr_sync(PR_IRQ_EN, irq_en & ~bit)) {
+		pr_poisoned = true;
+		return EIO;
+	}
+	if (!pr_free(t)) {
+		/* No payload was touched. Do not acknowledge somebody else's IRQ. */
+		if (!pr_sync(PR_IRQ_EN, (pr_read(pr_tcs, PR_IRQ_EN) & ~bit) | (irq_en & bit))) {
+			pr_poisoned = true;
+		}
+		return EBUSY;
+	}
+	/* From here an uncertain write/timeout quarantines our slot for this boot. */
+	pr_poisoned = true;
+	/* HPM (raw 7) is supported by this PMIC5 LDO; enable comes last. */
+	const uint32_t offsets[3] = {0, 8, 4};
+	const uint32_t values[3] = {mv, 7, 1};
+	printf("PERIDOT RPMH: TCS%u ACTIVE %u mV mode=7 enable=1 irq-enable=%#x\n", t, mv, irq_en);
+	for (unsigned c = 0; c < 3; ++c) {
+		uint32_t cmd = b + c * PR_CMD_STRIDE;
+		if (!pr_sync(cmd + PR_MSGID, PR_WRITE_ACK) ||
+		    !pr_sync(cmd + PR_ADDR, address + offsets[c]) ||
+		    !pr_sync(cmd + PR_DATA, values[c])) {
+			return EIO;
+		}
+	}
+	if (!pr_sync(b + PR_WAIT, 7) || !pr_sync(b + PR_ENABLE, 7) ||
+	    !pr_sync(b + PR_CONTROL, 0) || !pr_sync(b + PR_CONTROL, PR_AMC_EN)) {
+		return EIO;
+	}
+	pr_write(pr_tcs, b + PR_CONTROL, PR_AMC_EN | PR_TRIGGER);
+	uint32_t irq = 0, idle = 0, status[3] = {0, 0, 0};
+	bool done = false, progress = false;
+	for (unsigned us = 0; us < PR_TIMEOUT_US; ++us) {
+		irq = pr_read(pr_tcs, PR_IRQ_STATUS);
+		idle = pr_read(pr_tcs, b + PR_STATUS);
+		bool complete = true;
+		for (unsigned c = 0; c < 3; ++c) {
+			status[c] = pr_read(pr_tcs, b + PR_CMD_STATUS + c * PR_CMD_STRIDE);
+			complete &= status[c] != 0xffffffffu &&
+			    (status[c] & (PR_ISSUED | PR_COMPLETE)) == (PR_ISSUED | PR_COMPLETE);
+		}
+		/* A fresh IRQ or observed execution transition excludes stale CMD_STATUS. */
+		progress |= idle == 0 || !complete;
+		if (idle && idle != 0xffffffffu && irq != 0xffffffffu &&
+		    ((irq & bit) || progress) && complete) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	printf("PERIDOT RPMH: TCS%u done=%d irq=%#x idle=%#x control=%#x cmd-status=%#x/%#x/%#x\n",
+	    t, done, irq, idle, pr_read(pr_tcs, b + PR_CONTROL), status[0], status[1], status[2]);
+	if (!done) {
+		printf("PERIDOT RPMH: timeout; TCS quarantined, IRQ remains masked; no reset/retry\n");
+		return ETIMEDOUT;
+	}
+	/* Proven completion: clear trigger before mode, then free only our commands. */
+	if (!pr_sync(b + PR_CONTROL, PR_AMC_EN) || !pr_sync(b + PR_CONTROL, 0) ||
+	    !pr_sync(b + PR_ENABLE, 0) || !pr_sync(b + PR_WAIT, 0)) {
+		return EIO;
+	}
+	pr_write(pr_tcs, PR_IRQ_CLEAR, bit); /* W1C: never clear other TCS bits */
+	if ((pr_read(pr_tcs, PR_IRQ_STATUS) & bit) ||
+	    !pr_sync(PR_IRQ_EN, (pr_read(pr_tcs, PR_IRQ_EN) & ~bit) | (irq_en & bit))) {
+		return EIO;
+	}
+	pr_poisoned = false;
+	printf("PERIDOT RPMH: touch rail ACTIVE vote complete (rail voltage requires hardware verification)\n");
+	return 0;
+}
+
+int
+sweet_peridot_touch_rail_enable(const char *res, unsigned mv)
+{
+	/* Board-specific helper: do not apply PMIC5-LDO policy to arbitrary resources. */
+	if (!res || !((!strcmp(res, "ldob13") && mv == 3300) ||
+	    (!strcmp(res, "ldob23") && mv == 1800))) {
+		printf("PERIDOT RPMH: expected L13B3300mV or L23B1800mV\n");
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&pr_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (pr_poisoned) {
+		printf("PERIDOT RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = pr_map();
+	if (!error) {
+		error = pr_lookup(res, &address);
+	}
+	if (!error && address != (!strcmp(res, "ldob13") ? 0x42000u : 0x42800u)) {
+		printf("PERIDOT RPMH: unexpected touch rail cmd-db address %#x\n", address);
+		error = ENODEV;
+	}
+	if (!error) {
+		error = pr_send(address, mv);
+	}
+out:
+	if (error) {
+		printf("PERIDOT RPMH: enable failed errno=%d\n", error);
+	}
+	__atomic_store_n(&pr_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_spi_peridot.c b/bsd/dev/sweet_spi_peridot.c
index 39cef2f..7c38289 100644
--- a/bsd/dev/sweet_spi_peridot.c
+++ b/bsd/dev/sweet_spi_peridot.c
@@ -11,6 +11,7 @@
 #include <pexpert/pexpert.h>
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 void sweet_peridot_spi_init(void);
+extern int sweet_peridot_touch_rail_enable(const char *, unsigned);
 extern bool sweet_peridot_gpi_init(vm_offset_t);
 extern bool sweet_peridot_gpi_transfer(const uint8_t *, uint8_t *, unsigned, bool);
 
@@ -23,6 +24,7 @@ static vm_offset_t tp_se, tp_gcc, tp_gpio;
 static unsigned tp_depth;
 static bool tp_use_gpi;
 static uint8_t tp_tx[TP_MAX + 8], tp_rx[TP_MAX + 8], tp_info[TP_MAX];
+static bool tp_bitbang;
 
 static uint32_t
 tp_rd(vm_offset_t b, unsigned off)
@@ -40,6 +42,71 @@ tp_wr(vm_offset_t b, unsigned off, uint32_t v)
 	__asm__ volatile("dsb osh" ::: "memory");
 }
 
+/* Bit-banged SPI on the touch panel's own pins. The live DT assigns
+ * gpio16=MISO, gpio17=MOSI, gpio18=CLK, gpio19=CS (function qup0_se4_l0..3).
+ * The serial engine of this board cannot receive in FIFO mode, so the pins
+ * are used as plain GPIOs instead. */
+#define TP_MISO 16u
+#define TP_MOSI 17u
+#define TP_CLK 18u
+#define TP_CS 19u
+#define TP_GPIO_OE (1u << 9)	/* CTL bit 9: output enable (pinctrl-cliffs) */
+#define TP_GPIO_DRV6 (2u << 6)	/* CTL bits 8:6: 6 mA */
+
+static void
+tp_gpio_output(unsigned pin, bool high)
+{
+	tp_wr(tp_gpio, TP_IO(pin), (tp_rd(tp_gpio, TP_IO(pin)) & ~2u) | (high ? 2u : 0u));
+}
+
+static uint32_t
+tp_gpio_input(unsigned pin)
+{
+	return tp_rd(tp_gpio, TP_IO(pin)) & 1u;
+}
+
+static bool
+tp_bitbang_init(void)
+{
+	/* CTL: pull none, function 0 (GPIO), 6 mA, output enable for the
+	 * outputs. The engine is never clocked in this mode. */
+	tp_wr(tp_gpio, TP_CTRL(TP_MISO), (tp_rd(tp_gpio, TP_CTRL(TP_MISO)) & ~0x3ffu));
+	tp_wr(tp_gpio, TP_CTRL(TP_MOSI), (tp_rd(tp_gpio, TP_CTRL(TP_MOSI)) & ~0x3ffu) | TP_GPIO_DRV6 | TP_GPIO_OE);
+	tp_wr(tp_gpio, TP_CTRL(TP_CLK), (tp_rd(tp_gpio, TP_CTRL(TP_CLK)) & ~0x3ffu) | TP_GPIO_DRV6 | TP_GPIO_OE);
+	tp_wr(tp_gpio, TP_CTRL(TP_CS), (tp_rd(tp_gpio, TP_CTRL(TP_CS)) & ~0x3ffu) | TP_GPIO_DRV6 | TP_GPIO_OE);
+	tp_gpio_output(TP_MOSI, false);
+	tp_gpio_output(TP_CLK, false);
+	tp_gpio_output(TP_CS, true);
+	/* The panel drives MISO; a floating input would read as noise. */
+	printf("PERIDOT SPI: bit-bang pins ready MISO=%u MOSI=%u CLK=%u CS=%u\n",
+	    TP_MISO, TP_MOSI, TP_CLK, TP_CS);
+	return true;
+}
+
+/* One full-duplex byte loop, SPI mode 0, MSB first, chip selected throughout.
+ * The data returned during the address phase is discarded, exactly like the
+ * Goodix BerlinD framing (F1 + address + three dummy bytes + payload). */
+static bool
+tp_bitbang_transfer(unsigned n)
+{
+	if (!n || n > sizeof(tp_tx)) {
+		return false;
+	}
+	tp_gpio_output(TP_CS, false);
+	for (unsigned i = 0; i < n; ++i) {
+		uint8_t out = tp_tx[i], in = 0;
+		for (int bit = 7; bit >= 0; --bit) {
+			tp_gpio_output(TP_MOSI, (out >> bit & 1) != 0);
+			tp_gpio_output(TP_CLK, true);
+			in = (uint8_t)((in << 1) | tp_gpio_input(TP_MISO));
+			tp_gpio_output(TP_CLK, false);
+		}
+		tp_rx[i] = in;
+	}
+	tp_gpio_output(TP_CS, true);
+	return true;
+}
+
 /* Read-only DMA readiness snapshot. GPI DT resource a00000 includes an
  * EE offset10000: msm_gpi subtracts it before applying GPII register offsets.
  * Only dynamic APPS GPIIs1..4 are inspected; static GPII0 is untouched. */
@@ -162,6 +229,9 @@ tp_command(unsigned opcode)
 static bool
 tp_transfer(unsigned n)
 {
+	if (tp_bitbang) {
+		return tp_bitbang_transfer(n);
+	}
 	if (tp_use_gpi) {
 		return sweet_peridot_gpi_transfer(tp_tx, tp_rx, n, (tp_rd(tp_se, 0x22c) & 1) != 0);
 	}
@@ -264,6 +334,79 @@ tp_checksum(const uint8_t *b, unsigned n)
 	return (uint16_t)sum == (uint16_t)(b[n - 2] | b[n - 1] << 8);
 }
 
+/* Exact peridot DT: active reset GPIO128,6mA/output-low; IRQ129 input,
+ * bias disabled; AVDD L13B3.3V, IOVDD L23B1.8V. Only after DMA loopback. */
+static bool
+tp_power_on(void)
+{
+	/* Set the latch low before enabling output, preventing a reset glitch. */
+	tp_wr(tp_gpio, TP_IO(128), tp_rd(tp_gpio, TP_IO(128)) & ~2u);
+	tp_wr(tp_gpio, TP_CTRL(128), (tp_rd(tp_gpio, TP_CTRL(128)) & ~0x3ffu) | 0x280u);
+	if (sweet_peridot_touch_rail_enable("ldob13", 3300)) {
+		return false;
+	}
+	delay(3000);
+	if (sweet_peridot_touch_rail_enable("ldob23", 1800)) {
+		return false;
+	}
+	delay(15000);
+	tp_wr(tp_gpio, TP_CTRL(129), tp_rd(tp_gpio, TP_CTRL(129)) & ~0x23fu);
+	tp_wr(tp_gpio, TP_IO(128), tp_rd(tp_gpio, TP_IO(128)) | 2u);
+	delay(200000);
+	printf("PERIDOT TOUCH: power votes complete; reset=%#x/%#x irq=%#x/%#x\n",
+	    tp_rd(tp_gpio, TP_CTRL(128)), tp_rd(tp_gpio, TP_IO(128)),
+	    tp_rd(tp_gpio, TP_CTRL(129)), tp_rd(tp_gpio, TP_IO(129)));
+	return true;
+}
+
+/* Read the chip description over the current transport. Read-only: the
+ * sensor is never reset, configured or flashed. */
+static bool
+tp_probe_chip(void)
+{
+	uint8_t version[28];
+	if (!tp_read(0x10014, version, sizeof(version))) {
+		printf("PERIDOT SPI: Goodix version read failed\n");
+		return false;
+	}
+	printf("PERIDOT SPI: version first bytes %02x %02x %02x %02x, checksum=%d\n",
+	    version[0], version[1], version[2], version[3], tp_checksum(version, sizeof(version)));
+	if (!tp_checksum(version, sizeof(version)) || memcmp(version, "BERLIN", 6)) {
+		return false;
+	}
+	char product[9];
+	memcpy(product, version + 10, 8);
+	product[8] = 0;
+	printf("PERIDOT SPI: Goodix %s firmware %02x%02x%02x%02x\n",
+	    product, version[18], version[19], version[20], version[21]);
+	if (!tp_read(0x10070, tp_info, 2)) {
+		return false;
+	}
+	unsigned length = tp_info[0] | tp_info[1] << 8;
+	if (length < 34 || length > TP_MAX || !tp_read(0x10070, tp_info, length) ||
+	    !tp_checksum(tp_info, length)) {
+		printf("PERIDOT SPI: invalid IC_INFO length=%u/checksum\n", length);
+		return false;
+	}
+	unsigned off = 32; /* length + version16 + feature10 + fixed params4 */
+	for (unsigned i = 0; i < 5; ++i) {
+		if (off >= length - 2) {
+			return false;
+		}
+		unsigned count = tp_info[off++];
+		off += 2 * count;
+	}
+	if (off + 52 > length - 2) {
+		return false;
+	}
+	uint32_t addr = tp_info[off + 44] | (uint32_t)tp_info[off + 45] << 8 |
+	    (uint32_t)tp_info[off + 46] << 16 | (uint32_t)tp_info[off + 47] << 24;
+	printf("PERIDOT SPI: IC_INFO len=%u checksum OK touch=%#x head=%u point=%u; read-only probe complete\n",
+	    length, addr, tp_info[off + 48] | tp_info[off + 49] << 8,
+	    tp_info[off + 50] | tp_info[off + 51] << 8);
+	return true;
+}
