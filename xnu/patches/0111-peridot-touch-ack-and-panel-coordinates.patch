+/* Clamp contacts outside the cropped canvas before fixed-point conversion.
+ * Multiply only a non-negative value: shifting a negative signed value is UB. */
+static IOFixed
+sweet_touch_coordinate(int pixel, int offset, int logical)
+{
+	int p = pixel + offset;
+	p = p < 0 ? 0 : (p >= logical ? logical - 1 : p);
+	return (IOFixed)(((int64_t)p * 65536) / logical);
