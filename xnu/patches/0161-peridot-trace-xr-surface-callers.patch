+/* Opt-in, bounded user call chains for the unsupported XR allocation path.
+ * Use the kernel copyin-based walker only from a normal faultable syscall. */
+static uint32_t sweet_surface_xr_traces[2];
+
+static void
+sweet_surface_trace_xr(const SweetSurface *surface)
+{
+	if (surface->pixelFormat != 0x62336138u) return;
+	int enabled = 0;
+	if (!PE_parse_boot_argn("sweetxrtrace", &enabled, sizeof(enabled)) || !enabled) return;
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	unsigned slot;
+	if (!strcmp(name, "SpringBoard")) slot = 0;
+	else if (!strcmp(name, "backboardd")) slot = 1;
+	else return;
+	if (__atomic_fetch_add(&sweet_surface_xr_traces[slot], 1, __ATOMIC_RELAXED) >= 4) return;
+	if (!ml_get_interrupts_enabled() || get_preemption_level() != 0) {
+		IOLog("SWEET XR BT: %s id %u skipped: nonfaultable context\n", name, surface->id);
+		return;
+	}
+	uintptr_t frames[16] = {};
+	struct backtrace_user_info info = {};
+	unsigned count = backtrace_user(frames, 16, NULL, &info);
+	IOLog("SWEET XR BT: %s id %u %ux%u frames %u error %d flags 0x%x\n",
+	    name, surface->id, surface->width, surface->height, count,
+	    info.btui_error, (unsigned)info.btui_info);
+	for (unsigned i = 0; i < count; ++i)
+		IOLog("SWEET XR BT: %s id %u frame %u pc 0x%llx\n",
+		    name, surface->id, i, (unsigned long long)frames[i]);
+}
