+
+/* Mode5 stage. Re-establishes the vendor probe invariant -- the always-on
+ * pair cxo-aon (0x9004) and demet (0x900c), which gpu_cc_cliffs_probe
+ * force-enables -- and only then repeats the configuration AHB gate test
+ * plus one HALT-class sibling (cx-ff 0x90f8). The AHB enable never latched
+ * in 0115 or 0116 even after the hub RCG was programmed, while boot-loader
+ * writes such as demet did latch, so this separates "cbcr writes never
+ * latch" from "this branch refuses". Branch registers are read-modify-
+ * written: every bit except the enable latch is preserved, singles are
+ * restored immediately, the pair is restored last. Refuse unreadable
+ * registers and live/unknown domains before any write; leave for the
+ * diagnostic reset when a restore does not verify. No GMU, GPU core or
+ * SMMU access, no RCG writes, votes or firmware in this stage.
+ */
+#define PGPU_BRANCH_ON 1u
+#define PGPU_BRANCH_CXO_AON 0x9004u
+#define PGPU_BRANCH_DEMET 0x900cu
+#define PGPU_BRANCH_CX_FF 0x90f8u
+
+struct pgpu_branch_probe {
+	unsigned off;
+	uint32_t before;
+	uint32_t during;
+	uint32_t after;
+	bool accepted;
+	bool already_on;
+	bool restored;
+};
+
+/* Same bounded poll as the AHB gate, 10ms, for any cbcr latch. */
+static inline bool
+pgpu_branch_latch_settled(const struct pgpu_power_io *io, unsigned off,
+    bool on)
+{
+	for (unsigned i = 0; i < 100; ++i) {
+		io->delay_us(100);
+		uint32_t value = io->read(io->context, off);
+		if (value == UINT32_MAX) {
+			return false;
+		}
+		if (((value & PGPU_BRANCH_ON) != 0) == on) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* probes[0..pair_count-1] are the always-on pair: enabled after the CX
+ * power-on and restored after every single. probes[pair_count..count-1]
+ * are toggled one at a time and restored immediately. observe, when
+ * non-NULL, runs after CX power-on, after the pair, and after the singles. */
+static inline enum pgpu_clock_result
+pgpu_cx_hold_branch_matrix(const struct pgpu_power_io *io,
+    struct pgpu_branch_probe *probes, unsigned count, unsigned pair_count,
+    uint32_t *cx_final, uint32_t *gx_final,
+    void *observe_ctx, void (*observe)(void *observe_ctx))
+{
+	if (count == 0 || pair_count > count) {
+		return PGPU_CLOCK_REFUSED;
+	}
+	uint32_t cx = io->read(io->context, PGPU_CX_GDSCR);
+	uint32_t hw = io->read(io->context, PGPU_CX_HW);
+	uint32_t gx = io->read(io->context, PGPU_GX_GDSCR);
+	if (!pgpu_collapsed(cx) || !pgpu_collapsed(gx) ||
+	    hw == UINT32_MAX || (hw & PGPU_ON)) {
+		return PGPU_CLOCK_REFUSED;
+	}
+	for (unsigned i = 0; i < count; ++i) {
+		uint32_t value = io->read(io->context, probes[i].off);
+		if (value == UINT32_MAX) {
+			return PGPU_CLOCK_REFUSED;
+		}
+		probes[i].before = value;
+		probes[i].during = value;
+		probes[i].after = value;
+		probes[i].already_on = (value & PGPU_BRANCH_ON) != 0;
+		probes[i].accepted = probes[i].already_on;
+		probes[i].restored = true;
+	}
+	io->write(io->context, PGPU_CX_GDSCR, cx & ~PGPU_COLLAPSE);
+	bool powered = pgpu_power_wait(io, true);
+	cx = io->read(io->context, PGPU_CX_GDSCR);
+	gx = io->read(io->context, PGPU_GX_GDSCR);
+	if (cx == UINT32_MAX || (cx & (PGPU_HW_CONTROL | PGPU_OVERRIDE)) ||
+	    !pgpu_collapsed(gx)) {
+		return PGPU_CLOCK_OWNERSHIP_LOST;
+	}
+	if (powered) {
+		if (observe) {
+			observe(observe_ctx);
+		}
+		for (unsigned i = 0; i < pair_count; ++i) {
+			struct pgpu_branch_probe *p = &probes[i];
+			if (p->already_on) {
+				continue;
+			}
+			io->write(io->context, p->off, p->before | PGPU_BRANCH_ON);
+			(void)pgpu_branch_latch_settled(io, p->off, true);
+			p->during = io->read(io->context, p->off);
+			p->accepted = (p->during & PGPU_BRANCH_ON) != 0;
+		}
+		if (observe) {
+			observe(observe_ctx);
+		}
+		for (unsigned i = pair_count; i < count; ++i) {
+			struct pgpu_branch_probe *p = &probes[i];
+			if (p->already_on) {
+				continue;
+			}
+			io->write(io->context, p->off, p->before | PGPU_BRANCH_ON);
+			(void)pgpu_branch_latch_settled(io, p->off, true);
+			p->during = io->read(io->context, p->off);
+			p->accepted = (p->during & PGPU_BRANCH_ON) != 0;
+			io->write(io->context, p->off, p->before);
+			p->restored = pgpu_branch_latch_settled(io, p->off,
+			    (p->before & PGPU_BRANCH_ON) != 0);
+			p->after = io->read(io->context, p->off);
+			if (!p->restored) {
+				return PGPU_CLOCK_BRANCH_RESTORE_TIMEOUT;
+			}
+		}
+		if (observe) {
+			observe(observe_ctx);
+		}
+		for (unsigned i = pair_count; i > 0; --i) {
+			struct pgpu_branch_probe *p = &probes[i - 1];
+			if (p->already_on) {
+				continue;
+			}
+			io->write(io->context, p->off, p->before);
+			if (!pgpu_branch_latch_settled(io, p->off,
+			    (p->before & PGPU_BRANCH_ON) != 0)) {
+				return PGPU_CLOCK_BRANCH_RESTORE_TIMEOUT;
+			}
+			p->after = io->read(io->context, p->off);
+			p->restored = true;
+		}
+	}
+	io->write(io->context, PGPU_CX_GDSCR, cx | PGPU_COLLAPSE);
+	if (!pgpu_power_wait(io, false) ||
+	    !pgpu_collapsed(io->read(io->context, PGPU_CX_GDSCR))) {
+		return PGPU_CLOCK_OFF_TIMEOUT;
+	}
+	if (cx_final) {
+		*cx_final = io->read(io->context, PGPU_CX_GDSCR);
+	}
+	if (gx_final) {
+		*gx_final = io->read(io->context, PGPU_GX_GDSCR);
+	}
+	if (!powered) {
+		return PGPU_CLOCK_ON_TIMEOUT;
+	}
+	unsigned accepted = 0;
+	unsigned fresh = 0;
+	for (unsigned i = 0; i < count; ++i) {
+		if (probes[i].already_on) {
+			continue;
+		}
+		fresh++;
+		if (probes[i].accepted) {
+			accepted++;
+		}
+	}
+	if (fresh != 0 && accepted == 0) {
+		return PGPU_CLOCK_BRANCH_NONE_LATCHED;
+	}
+	if (accepted != fresh) {
+		return PGPU_CLOCK_BRANCH_PARTIAL_LATCH;
+	}
+	return PGPU_CLOCK_PASS;
+}
