+/* ---- 0124: read-only GPU SMMU inventory ----
+ * The gen7 GMU image's main code sits at GMU IOVA0x4000, not in ITCM, so the
+ * CM3 cannot fetch it before the GPU SMMU translates SID5. The live DT node
+ * kgsl-smmu@3da0000 (qcom,qsmmu-v500) has reg base0x3da0000/0x40000 and
+ * tcu-base0x3de6000/0x40; its vdd is gpu_cc_cx_gdsc, so it is powered exactly
+ * while the 0121 stage holds CX. That stage also enables gpu_cc_ahb(0x90c8)
+ * and the gpu_cc_hlos1_vote_gpu_smmu vote(0x7000), the SMMU's AHB and TCU
+ * clocks, so the inventory runs from the same observe hook. It only reads
+ * the global control/ID/fault registers, every stream-match entry and the
+ * registers of every context bank whose CBAR is valid. No TCU/TBU block
+ * access, no write, no context or table allocation, no firmware.
+ */
+#define PGPU_SMMU_BASE 0x3da0000u
+#define PGPU_SMMU_BYTES 0x40000u
+#define PGPU_SMMU_sCR0 0x000u
+#define PGPU_SMMU_sCR1 0x004u
+#define PGPU_SMMU_sCR2 0x008u
+#define PGPU_SMMU_sACR 0x010u
+#define PGPU_SMMU_sIDR0 0x020u
+#define PGPU_SMMU_sGFAR 0x040u
+#define PGPU_SMMU_sGFSR 0x048u
+#define PGPU_SMMU_SMR 0x800u
+#define PGPU_SMMU_S2CR 0xc00u
+#define PGPU_SMMU_CBAR 0x1000u
+#define PGPU_SMMU_CBA2R 0x1800u
+#define PGPU_SMMU_CB 0x2000u
+#define PGPU_SMMU_CB_SIZE 0x1000u
+#define PGPU_SMMU_STREAMS 256u
+#define PGPU_SMMU_BANKS 32u
+#define PGPU_SMMU_SMR_VALID (1u << 31)
+#define PGPU_SMMU_CBAR_VALID 1u
+#define PGPU_SMMU_SID_GMU 5u
+#define PGPU_SMMU_NO_MATCH 0xffffffffu
+
+struct pgpu_smmu_inventory {
+	uint32_t scr0, scr1, scr2, acr;
+	uint32_t id[8];
+	uint32_t gfar, gfsr;
+	unsigned smr_valid, cb_valid;
+	unsigned sid5_smr;	/* PGPU_SMMU_NO_MATCH when SID5 has none */
+	uint32_t sid5_s2cr;
+};
+
+struct pgpu_smmu_inventory_ctx {
+	vm_offset_t base;
+	struct pgpu_smmu_inventory *inv;
+};
+
+struct pgpu_full_inventory_ctx {
+	struct pgpu_gmu_inventory_ctx gmu;
+	struct pgpu_smmu_inventory_ctx smmu;
+};
+
+static bool
+pgpu_smmu_sid_match(uint32_t smr, unsigned sid)
+{
+	unsigned mask;
+
+	if (!(smr & PGPU_SMMU_SMR_VALID)) {
+		return false;
+	}
+	mask = (smr >> 16) & 0xffu;
+	return ((smr & 0xffffu) & ~mask) == (sid & ~mask);
+}
+
+static void
+pgpu_smmu_inventory_read(void *context)
+{
+	struct pgpu_smmu_inventory_ctx *ctx = context;
+	struct pgpu_smmu_inventory *inv = ctx->inv;
+	vm_offset_t s = ctx->base;
+	unsigned i;
+
+	inv->scr0 = pgpu_read(s, PGPU_SMMU_sCR0);
+	inv->scr1 = pgpu_read(s, PGPU_SMMU_sCR1);
+	inv->scr2 = pgpu_read(s, PGPU_SMMU_sCR2);
+	inv->acr = pgpu_read(s, PGPU_SMMU_sACR);
+	for (i = 0; i < 8; ++i) {
+		inv->id[i] = pgpu_read(s, PGPU_SMMU_sIDR0 + i * 4);
+	}
+	inv->gfar = pgpu_read(s, PGPU_SMMU_sGFAR);
+	inv->gfsr = pgpu_read(s, PGPU_SMMU_sGFSR);
+	inv->smr_valid = 0;
+	inv->sid5_smr = PGPU_SMMU_NO_MATCH;
+	inv->sid5_s2cr = 0;
+	for (i = 0; i < PGPU_SMMU_STREAMS; ++i) {
+		uint32_t smr = pgpu_read(s, PGPU_SMMU_SMR + i * 4);
+		uint32_t s2cr;
+
+		if (!(smr & PGPU_SMMU_SMR_VALID)) {
+			continue;
+		}
+		s2cr = pgpu_read(s, PGPU_SMMU_S2CR + i * 4);
+		++inv->smr_valid;
+		if (pgpu_smmu_sid_match(smr, PGPU_SMMU_SID_GMU) &&
+		    inv->sid5_smr == PGPU_SMMU_NO_MATCH) {
+			inv->sid5_smr = i;
+			inv->sid5_s2cr = s2cr;
+		}
+		printf("PERIDOT GPU: SMMU SMR%u=%#x S2CR%u=%#x%s\n",
+		    i, smr, i, s2cr,
+		    pgpu_smmu_sid_match(smr, PGPU_SMMU_SID_GMU) ?
+		    " sid5" : "");
+	}
+	inv->cb_valid = 0;
+	for (i = 0; i < PGPU_SMMU_BANKS; ++i) {
+		uint32_t cbar = pgpu_read(s, PGPU_SMMU_CBAR + i * 4);
+		uint32_t cba2r;
+		vm_offset_t cb;
+
+		if (!(cbar & PGPU_SMMU_CBAR_VALID)) {
+			continue;
+		}
+		cba2r = pgpu_read(s, PGPU_SMMU_CBA2R + i * 4);
+		cb = s + PGPU_SMMU_CB + i * PGPU_SMMU_CB_SIZE;
+		++inv->cb_valid;
+		printf("PERIDOT GPU: SMMU CB%u CBAR=%#x CBA2R=%#x SCTLR=%#x ACTLR=%#x\n",
+		    i, cbar, cba2r, pgpu_read(cb, 0x000), pgpu_read(cb, 0x004));
+		printf("PERIDOT GPU: SMMU CB%u TCR2=%#x TCR=%#x TTBR0=%#x:%#x MAIR=%#x/%#x FSR=%#x FAR=%#x:%#x\n",
+		    i, pgpu_read(cb, 0x010), pgpu_read(cb, 0x030),
+		    pgpu_read(cb, 0x024), pgpu_read(cb, 0x020),
+		    pgpu_read(cb, 0x038), pgpu_read(cb, 0x03c),
+		    pgpu_read(cb, 0x058),
+		    pgpu_read(cb, 0x064), pgpu_read(cb, 0x060));
+	}
+}
+
+static void
+pgpu_full_inventory_read(void *context)
+{
+	struct pgpu_full_inventory_ctx *ctx = context;
+
+	pgpu_gmu_inventory_read(&ctx->gmu);
+	pgpu_smmu_inventory_read(&ctx->smmu);
+}
+
 
