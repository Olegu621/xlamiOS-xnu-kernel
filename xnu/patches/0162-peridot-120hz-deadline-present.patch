+/* Keep the original phase. A slow copy/shot skips expired slots instead of
+ * adding its duration to every frame, or issuing a burst of overdue callbacks. */
+void
+AppleCLCD::armVsync(IOTimerEventSource *sender)
+{
+	uint64_t now = mach_absolute_time();
+	fNextVsync += fVsyncPeriod;
+	if (fNextVsync <= now) {
+		uint64_t skipped = (now - fNextVsync) / fVsyncPeriod + 1;
+		fNextVsync += skipped * fVsyncPeriod;
+		fSkippedSlots += skipped;
+	}
+	uint64_t elapsedNS;
+	absolutetime_to_nanoseconds(now - fReportStart, &elapsedNS);
+	if (elapsedNS >= 5ULL * NSEC_PER_SEC) {
+		uint64_t copyNS, maxNS, swaps;
+		absolutetime_to_nanoseconds(fCopyTime, &copyNS);
+		absolutetime_to_nanoseconds(fCopyMax, &maxNS);
+		IOLockLock(fLock);
+		swaps = fSwapCount;
+		IOLockUnlock(fLock);
+		IOLog("SWEET FB RATE: window_ms=%llu callbacks=%llu swaps=%llu attempts=%llu copied=%llu copy_us=%llu max_us=%llu missed=%llu\n",
+		    elapsedNS / 1000000, fVsyncCount - fReportTicks, swaps - fReportSwapBase,
+		    fPresentAttempts, fCopiedFrames, copyNS / 1000, maxNS / 1000, fSkippedSlots);
+		fReportStart = now;
+		fReportTicks = fVsyncCount;
+		fReportSwapBase = swaps;
+		fPresentAttempts = fCopiedFrames = fCopyTime = fCopyMax = fSkippedSlots = 0;
+	}
+	/* Logging can itself consume a slot: sample the clock again before arming. */
+	now = mach_absolute_time();
+	if (fNextVsync <= now) {
+		uint64_t skipped = (now - fNextVsync) / fVsyncPeriod + 1;
+		fNextVsync += skipped * fVsyncPeriod;
+		fSkippedSlots += skipped;
+	}
+	sender->wakeAtTime(fNextVsync);
 }
 
