+/* ---- 0122: read-only GMU inventory ----
+ * GMU registers are GMU_WORD(n)=4*n from the GMU base; the live DT node
+ * qcom,gmu has reg 0x3d68000 size0x34000 (its unit address differs). The
+ * inventory observes what the boot loader left: CM3 reset/boot state,
+ * firmware init result, the always-on counter (19.2MHz crystal), the
+ * power/clock status, RPMh power state and the HFI/AO handshake. It runs
+ * inside the 0121 clock stage while the GMU tree is up and CX is live,
+ * before the branches are restored, so the AHB access is clocked. Read
+ * only: no GMU write, no firmware load, no GPU core or SMMU access.
+ */
+#define PGPU_GMU_CM3_SYSRESET 0x14000u
+#define PGPU_GMU_CM3_BOOT_CONFIG 0x14004u
+#define PGPU_GMU_CM3_FW_INIT_RESULT 0x14070u
+#define PGPU_GMU_CM3_CFG 0x140b4u
+#define PGPU_GMU_ALWAYS_ON_COUNTER_L 0x14220u
+#define PGPU_GMU_ALWAYS_ON_COUNTER_H 0x14224u
+#define PGPU_GMU_SPTPRAC_PWR_CLK_STATUS 0x14340u
+#define PGPU_GMU_RPMH_POWER_STATE 0x143b0u
+#define PGPU_GMU_HFI_CTRL_STATUS 0x14600u
+#define PGPU_GMU_HFI_VERSION_INFO 0x14604u
+#define PGPU_GMU_AO_HOST_INTERRUPT_STATUS 0x24c14u
+#define PGPU_GMU_RSCC_CONTROL_ACK 0x24c20u
+#define PGPU_GMU_AO_GPU_CX_BUSY_STATUS 0x24c30u
+#define PGPU_GMU_AHB_FENCE_STATUS 0x24c4cu
+
+struct pgpu_gmu_inventory {
+	uint32_t sysreset, boot_config, fw_init, cfg;
+	uint32_t counter_lo, counter_hi, counter_lo2, counter_hi2;
+	uint32_t sptprac, rpmh_state;
+	uint32_t hfi_ctrl, hfi_version;
+	uint32_t ao_intr, rscc_ack, ao_busy, fence;
+};
+
+struct pgpu_gmu_inventory_ctx {
+	vm_offset_t base;
+	struct pgpu_gmu_inventory *inv;
+};
+
+static void
+pgpu_gmu_inventory_read(void *context)
+{
+	struct pgpu_gmu_inventory_ctx *ctx = context;
+	struct pgpu_gmu_inventory *inv = ctx->inv;
+	vm_offset_t g = ctx->base;
+	inv->sysreset = pgpu_read(g, PGPU_GMU_CM3_SYSRESET);
+	inv->boot_config = pgpu_read(g, PGPU_GMU_CM3_BOOT_CONFIG);
+	inv->fw_init = pgpu_read(g, PGPU_GMU_CM3_FW_INIT_RESULT);
+	inv->cfg = pgpu_read(g, PGPU_GMU_CM3_CFG);
+	inv->counter_lo = pgpu_read(g, PGPU_GMU_ALWAYS_ON_COUNTER_L);
+	inv->counter_hi = pgpu_read(g, PGPU_GMU_ALWAYS_ON_COUNTER_H);
+	delay(1000);
+	inv->counter_lo2 = pgpu_read(g, PGPU_GMU_ALWAYS_ON_COUNTER_L);
+	inv->counter_hi2 = pgpu_read(g, PGPU_GMU_ALWAYS_ON_COUNTER_H);
+	inv->sptprac = pgpu_read(g, PGPU_GMU_SPTPRAC_PWR_CLK_STATUS);
+	inv->rpmh_state = pgpu_read(g, PGPU_GMU_RPMH_POWER_STATE);
+	inv->hfi_ctrl = pgpu_read(g, PGPU_GMU_HFI_CTRL_STATUS);
+	inv->hfi_version = pgpu_read(g, PGPU_GMU_HFI_VERSION_INFO);
+	inv->ao_intr = pgpu_read(g, PGPU_GMU_AO_HOST_INTERRUPT_STATUS);
+	inv->rscc_ack = pgpu_read(g, PGPU_GMU_RSCC_CONTROL_ACK);
+	inv->ao_busy = pgpu_read(g, PGPU_GMU_AO_GPU_CX_BUSY_STATUS);
+	inv->fence = pgpu_read(g, PGPU_GMU_AHB_FENCE_STATUS);
+}
