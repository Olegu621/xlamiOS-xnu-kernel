+/* ---- 0119: GPUCC clock measurement through the GCC debug counter ----
+ * The GPUCC branch registers are not reliable status sources on this
+ * family: the configuration AHB enable bit reads0 before and after it is
+ * written (the vendor driver writes it and waits10us without checking),
+ * and the DELAY-class halt bit says nothing about the clock. Measure the
+ * clocks instead. The GCC debug mux routes the GPUCC debug mux output to
+ * the GCC ring counter, which counts the selected clock against XO/4
+ * while the control register's terminal count runs. Register layout and
+ * select values are those of the vendor debugcc-cliffs driver: GCC debug
+ * mux0x62024 (10-bit), divider0x62000, branch0x62004, XO/4 branch
+ * 0x62008, control0x62048, status0x6204c, GPUCC debug output selected by
+ * 0x17d; GPUCC debug mux0x9564 (8-bit), divider0x9140, branch0x9144.
+ * Both debug dividers are programmed to their field value1, which
+ * divides by two each, so the counter sees a quarter of the measured
+ * clock and the reported rate is multiplied by4. A clock that does not
+ * run leaves the counter unchanged, which is detected by comparing the
+ * short (0x1000 ticks) and full (0x20000 ticks) counts, exactly like the
+ * vendor driver. Only debug registers and the CX collapse bit are
+ * written; the debug registers are saved and restored around every
+ * single measurement, and the counter poll is bounded at200ms.
+ */
+#define PGPU_GCC_DEBUG_MUX 0x62024u
+#define PGPU_GCC_DEBUG_DIV 0x62000u
+#define PGPU_GCC_DEBUG_CBCR 0x62004u
+#define PGPU_GCC_XO_DIV4_CBCR 0x62008u
+#define PGPU_GCC_MEASURE_CTL 0x62048u
+#define PGPU_GCC_MEASURE_STATUS 0x6204cu
+#define PGPU_GCC_DEBUG_SEL_GPUCC 0x17du
+#define PGPU_GPUCC_DEBUG_MUX 0x9564u
+#define PGPU_GPUCC_DEBUG_DIV 0x9140u
+#define PGPU_GPUCC_DEBUG_CBCR 0x9144u
+#define PGPU_GCC_DEBUG_MUX_MASK 0x3ffu
+#define PGPU_DEBUG_MUX_MASK 0xffu
+#define PGPU_DEBUG_DIV_MASK 0xfu
+#define PGPU_DEBUG_DIV_FIELD 1u
+#define PGPU_MEASURE_CNT_EN (1u << 20)
+#define PGPU_MEASURE_CLR_CNT (1u << 21)
+#define PGPU_MEASURE_DONE (1u << 25)
+#define PGPU_MEASURE_TERM 0xfffffu
+#define PGPU_MEASURE_COUNT 0x1ffffffu
+#define PGPU_MEASURE_BRIEF 0x1000u
+#define PGPU_MEASURE_FULL 0x20000u
+#define PGPU_XO_DIV4_HZ 4800000u
+#define PGPU_MEASURE_SETTLE_US 10u
+
+struct pgpu_measure_probe {
+	unsigned measured_handoff;
+	unsigned measured_live;
+	bool counter_ok;
+	bool cx_powered;
+	bool cx_restored;
+};
+
+/* One counter run: returns false when the status never reports DONE within
+ * 200ms. The control register is left with CNT_EN cleared and the terminal
+ * count programmed; the caller restores its saved value. */
+static inline bool
+pgpu_measure_counter_run(const struct pgpu_power_io *io, uint32_t ticks,
+    uint32_t *count)
+{
+	uint32_t ctl = io->read(io->context, PGPU_GCC_MEASURE_CTL);
+	if (ctl == UINT32_MAX) {
+		return false;
+	}
+	uint32_t base = ctl & ~(PGPU_MEASURE_CNT_EN | PGPU_MEASURE_CLR_CNT |
+	    PGPU_MEASURE_TERM);
+	io->write(io->context, PGPU_GCC_MEASURE_CTL, base);
+	io->write(io->context, PGPU_GCC_MEASURE_CTL,
+	    base | PGPU_MEASURE_CLR_CNT);
+	io->delay_us(1);
+	io->write(io->context, PGPU_GCC_MEASURE_CTL,
+	    base | (ticks & PGPU_MEASURE_TERM));
+	io->write(io->context, PGPU_GCC_MEASURE_CTL,
+	    base | (ticks & PGPU_MEASURE_TERM) | PGPU_MEASURE_CNT_EN);
+	for (unsigned i = 0; i < 2000; ++i) {
+		uint32_t status = io->read(io->context,
+		    PGPU_GCC_MEASURE_STATUS);
+		if (status == UINT32_MAX) {
+			break;
+		}
+		if (status & PGPU_MEASURE_DONE) {
+			io->write(io->context, PGPU_GCC_MEASURE_CTL,
+			    base | (ticks & PGPU_MEASURE_TERM));
+			*count = status & PGPU_MEASURE_COUNT;
+			return true;
+		}
+		io->delay_us(100);
+	}
+	io->write(io->context, PGPU_GCC_MEASURE_CTL,
+	    base | (ticks & PGPU_MEASURE_TERM));
+	return false;
+}
+
+/* Rate of one GPUCC clock in Hz, 0 when it does not run, false when the
+ * counter does not finish or a register is unreadable. Every debug
+ * register is restored before returning. */
+static inline bool
+pgpu_measure_clock(const struct pgpu_power_io *io, unsigned sel,
+    uint32_t *hz)
+{
+	uint32_t gcc_mux = io->read(io->context, PGPU_GCC_DEBUG_MUX);
+	uint32_t gcc_div = io->read(io->context, PGPU_GCC_DEBUG_DIV);
+	uint32_t gcc_cbcr = io->read(io->context, PGPU_GCC_DEBUG_CBCR);
+	uint32_t xo = io->read(io->context, PGPU_GCC_XO_DIV4_CBCR);
+	uint32_t ctl = io->read(io->context, PGPU_GCC_MEASURE_CTL);
+	uint32_t gpu_mux = io->read(io->context, PGPU_GPUCC_DEBUG_MUX);
+	uint32_t gpu_div = io->read(io->context, PGPU_GPUCC_DEBUG_DIV);
+	uint32_t gpu_cbcr = io->read(io->context, PGPU_GPUCC_DEBUG_CBCR);
+	if (gcc_mux == UINT32_MAX || gcc_div == UINT32_MAX ||
+	    gcc_cbcr == UINT32_MAX || xo == UINT32_MAX || ctl == UINT32_MAX ||
+	    gpu_mux == UINT32_MAX || gpu_div == UINT32_MAX ||
+	    gpu_cbcr == UINT32_MAX) {
+		return false;
+	}
+	io->write(io->context, PGPU_GCC_DEBUG_DIV,
+	    (gcc_div & ~PGPU_DEBUG_DIV_MASK) | PGPU_DEBUG_DIV_FIELD);
+	io->write(io->context, PGPU_GPUCC_DEBUG_DIV,
+	    (gpu_div & ~PGPU_DEBUG_DIV_MASK) | PGPU_DEBUG_DIV_FIELD);
+	io->write(io->context, PGPU_GPUCC_DEBUG_MUX,
+	    (gpu_mux & ~PGPU_DEBUG_MUX_MASK) | (sel & PGPU_DEBUG_MUX_MASK));
+	io->write(io->context, PGPU_GCC_DEBUG_MUX,
+	    (gcc_mux & ~PGPU_GCC_DEBUG_MUX_MASK) | PGPU_GCC_DEBUG_SEL_GPUCC);
+	io->write(io->context, PGPU_GPUCC_DEBUG_CBCR, gpu_cbcr | 1u);
+	io->write(io->context, PGPU_GCC_DEBUG_CBCR, gcc_cbcr | 1u);
+	io->write(io->context, PGPU_GCC_XO_DIV4_CBCR, xo | 1u);
+	io->delay_us(PGPU_MEASURE_SETTLE_US);
+	uint32_t brief = 0, full = 0;
+	bool ok = pgpu_measure_counter_run(io, PGPU_MEASURE_BRIEF, &brief) &&
+	    pgpu_measure_counter_run(io, PGPU_MEASURE_FULL, &full);
+	io->write(io->context, PGPU_GCC_XO_DIV4_CBCR, xo);
+	io->write(io->context, PGPU_GCC_DEBUG_CBCR, gcc_cbcr);
+	io->write(io->context, PGPU_GPUCC_DEBUG_CBCR, gpu_cbcr);
+	io->write(io->context, PGPU_GCC_DEBUG_MUX, gcc_mux);
+	io->write(io->context, PGPU_GPUCC_DEBUG_MUX, gpu_mux);
+	io->write(io->context, PGPU_GPUCC_DEBUG_DIV, gpu_div);
+	io->write(io->context, PGPU_GCC_DEBUG_DIV, gcc_div);
+	io->write(io->context, PGPU_GCC_MEASURE_CTL, ctl);
+	if (!ok) {
+		return false;
+	}
+	*hz = 0;
+	if (full != brief) {
+		uint64_t value = ((uint64_t)full * 10u + 15u) *
+		    PGPU_XO_DIV4_HZ;
+		value /= (uint64_t)PGPU_MEASURE_FULL * 10u + 35u;
+		value *= 4u;
+		*hz = (uint32_t)value;
+	}
+	return true;
+}
+
+/* Mode7 stage. CX is collapsed on entry. Measures the caller's GPUCC clock
+ * list through the debug counter while CX is off, powers CX, measures the
+ * same list again while it is live, then collapses CX and verifies it. The
+ * clocks themselves are not changed: only debug muxes, dividers, branches
+ * and the CX collapse bit are written. A refused precondition means no
+ * measurement and no CX write.
+ */
+static inline enum pgpu_clock_result
+pgpu_cx_clock_measure_stage(const struct pgpu_power_io *io,
+    const unsigned *sels, unsigned count, uint32_t *handoff_hz,
+    uint32_t *live_hz, struct pgpu_measure_probe *probe,
+    uint32_t *cx_final, uint32_t *gx_final)
+{
+	uint32_t cx = io->read(io->context, PGPU_CX_GDSCR);
+	uint32_t hw = io->read(io->context, PGPU_CX_HW);
+	uint32_t gx = io->read(io->context, PGPU_GX_GDSCR);
+	if (count == 0 || !pgpu_collapsed(cx) || !pgpu_collapsed(gx) ||
+	    hw == UINT32_MAX || (hw & PGPU_ON)) {
+		return PGPU_CLOCK_REFUSED;
+	}
+	probe->counter_ok = true;
+	for (unsigned i = 0; i < count; ++i) {
+		if (!pgpu_measure_clock(io, sels[i], &handoff_hz[i])) {
+			probe->counter_ok = false;
+			break;
+		}
+		probe->measured_handoff = i + 1;
+	}
+	io->write(io->context, PGPU_CX_GDSCR, cx & ~PGPU_COLLAPSE);
+	probe->cx_powered = pgpu_power_wait(io, true);
+	cx = io->read(io->context, PGPU_CX_GDSCR);
+	gx = io->read(io->context, PGPU_GX_GDSCR);
+	if (cx == UINT32_MAX || (cx & (PGPU_HW_CONTROL | PGPU_OVERRIDE)) ||
+	    !pgpu_collapsed(gx)) {
+		return PGPU_CLOCK_OWNERSHIP_LOST;
+	}
+	if (probe->cx_powered && probe->counter_ok) {
+		for (unsigned i = 0; i < count; ++i) {
+			if (!pgpu_measure_clock(io, sels[i], &live_hz[i])) {
+				probe->counter_ok = false;
+				break;
+			}
+			probe->measured_live = i + 1;
+		}
+	}
+	io->write(io->context, PGPU_CX_GDSCR, cx | PGPU_COLLAPSE);
+	probe->cx_restored = pgpu_power_wait(io, false) &&
+	    pgpu_collapsed(io->read(io->context, PGPU_CX_GDSCR));
+	if (cx_final) {
+		*cx_final = io->read(io->context, PGPU_CX_GDSCR);
+	}
+	if (gx_final) {
+		*gx_final = io->read(io->context, PGPU_GX_GDSCR);
+	}
+	if (!probe->cx_powered) {
+		return PGPU_CLOCK_ON_TIMEOUT;
+	}
+	if (!probe->cx_restored) {
+		return PGPU_CLOCK_OFF_TIMEOUT;
+	}
+	if (!probe->counter_ok) {
+		return PGPU_CLOCK_MEASURE_COUNTER_TIMEOUT;
+	}
+	return PGPU_CLOCK_MEASURE_PASS;
+}
 #endif
